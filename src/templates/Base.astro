---
import '@/styles/global.css';

import CustomCursor from '@/components/CustomCursor.astro';
import Footer from '@/components/Footer.astro';
import Navbar from '@/components/Navbar.astro';
import Preloader from '@/components/Preloader.astro';
import SmoothScroll from '@/components/SmoothScroll.astro';
import { AppConfig } from '@/utils/AppConfig';

export interface Props {
  head?: {
    title?: string;
    description?: string;
  };
}

const { head } = Astro.props as Props;
const title = head?.title ?? AppConfig.title;
const description = head?.description ?? AppConfig.description;
---

<!DOCTYPE html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AppConfig.author} />

    <!-- Google Fonts Preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="relative min-h-screen bg-[#f8fafc] text-ink-900 antialiased selection:bg-brand-200 selection:text-brand-800">
    <!-- GSAP Preloader Curtain -->
    <Preloader />

    <!-- Smooth momentum scrolling (Lenis + GSAP RAF) -->
    <SmoothScroll />

    <!-- Interactive Custom Cursor follower -->
    <CustomCursor />

    <!-- Sticky Navigation Header -->
    <Navbar />

    <!-- Main Content Area -->
    <main id="main-content" class="relative">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />
  </body>
</html>
