---
---
<footer class="border-t border-slate-200 bg-white py-12 px-6 lg:px-12">
  <div class="max-w-7xl mx-auto flex flex-col md:flex-row items-center justify-between gap-6 font-mono text-xs text-ink-500">
    <!-- Left: Copyright -->
    <div class="flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-sky-500"></span>
      <span class="text-ink-700 font-medium">© 2026 DIỆU THẢO — BUSINESS ANALYST PORTFOLIO.</span>
    </div>

    <!-- Center: Method Credit -->
    <div class="text-center text-ink-400 text-[11px] tracking-wider uppercase">
      BABOK® &amp; AGILE METHODOLOGY
    </div>

    <!-- Right: Back To Top Button -->
    <button 
      id="back-to-top" 
      class="group flex items-center gap-2 text-ink-600 hover:text-sky-600 transition-colors cursor-pointer"
      data-cursor="interactive"
    >
      <span>&#123; BACK TO TOP &#125;</span>
      <svg class="w-3.5 h-3.5 transform group-hover:-translate-y-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
      </svg>
    </button>
  </div>
</footer>

<script>
  window.addEventListener('DOMContentLoaded', () => {
    const topBtn = document.getElementById('back-to-top');
    topBtn?.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth',
      });
    });
  });
</script>
