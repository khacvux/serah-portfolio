---
---
<footer class="border-t border-[#122840] bg-[#040e1e] py-12 px-6 lg:px-12 text-[#7ca6ce]">
  <div class="max-w-[1440px] mx-auto flex flex-col md:flex-row items-center justify-between gap-6 font-mono text-xs">
    <!-- Left: Copyright matching Jack Elder -->
    <div class="flex items-center gap-2">
      <span class="w-1.5 h-1.5 rounded-full bg-[#38bdf8]"></span>
      <span class="text-white font-medium">© 2026 DIỆU THẢO — BUSINESS &amp; DATA ANALYST</span>
    </div>

    <!-- Center: Method Credit -->
    <div class="text-center text-[#51769c] text-[11px] tracking-wider uppercase">
      BABOK® &amp; AGILE STANDARDS
    </div>

    <!-- Right: Back To Top Button matching Jack Elder -->
    <button 
      id="back-to-top" 
      class="group flex items-center gap-2 text-white hover:text-sky-300 transition-colors cursor-pointer"
      data-cursor="interactive"
    >
      <span>&#123; BACK TO TOP &#125;</span>
      <svg class="w-3.5 h-3.5 transform group-hover:-translate-y-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
      </svg>
    </button>
  </div>
</footer>

<script>
  window.addEventListener('DOMContentLoaded', () => {
    const topBtn = document.getElementById('back-to-top');
    topBtn?.addEventListener('click', () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth',
      });
    });
  });
</script>
