---
---
<section id="contact" class="py-24 sm:py-36 px-6 lg:px-12 max-w-7xl mx-auto relative overflow-hidden">
  <!-- Sky ambient glow behind contact -->
  <div class="absolute bottom-0 right-1/4 w-[600px] h-[600px] bg-sky-400/15 rounded-full blur-[140px] pointer-events-none -z-10"></div>

  <!-- Header -->
  <div class="contact-header border-b border-slate-200 pb-8 mb-16 flex flex-col md:flex-row md:items-end justify-between gap-6">
    <div class="space-y-3">
      <div class="flex items-center gap-2 text-xs font-mono tracking-widest text-sky-600 font-bold uppercase">
        <span class="w-1.5 h-1.5 rounded-full bg-sky-500 animate-pulse"></span>
        <span>&#123; 05 / RECRUITMENT &amp; CONTACT &#125;</span>
      </div>
      <h2 class="text-4xl sm:text-6xl font-bold tracking-tight text-ink-950 uppercase">
        LET'S CONNECT
      </h2>
    </div>
    <div class="text-xs font-mono text-ink-500">
      <span class="text-ink-400">// AVAILABILITY</span> INTERNSHIP &amp; JUNIOR BA ROLES (2026)
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
    <!-- Big Headline Callout -->
    <div class="contact-left lg:col-span-8 space-y-8">
      <div class="space-y-4">
        <h3 class="text-4xl sm:text-6xl md:text-7xl font-bold text-ink-950 tracking-tight leading-[1.05]">
          Looking for a driven <br />
          <span class="font-serif italic font-normal text-sky-600 text-5xl sm:text-7xl md:text-8xl">Business Analyst</span> Intern?
        </h3>
        <p class="text-lg sm:text-xl text-ink-600 max-w-xl font-light leading-relaxed pt-2">
          I am actively seeking Business Analyst Intern, Product Analyst, and Associate ITBA positions. Ready to contribute with structured requirements, wireframes, and data analysis.
        </p>
      </div>

      <!-- Interactive Copy Email Box -->
      <div class="pt-4 flex flex-col sm:flex-row sm:items-center gap-4">
        <button 
          id="copy-email-btn"
          class="group relative inline-flex items-center justify-between gap-6 px-6 sm:px-8 py-5 rounded-2xl bg-white border border-slate-200 hover:border-sky-400 text-left transition-colors duration-300 shadow-sm hover:shadow-[0_10px_30px_rgba(2,132,199,0.12)] cursor-pointer"
          data-cursor="interactive"
        >
          <div class="flex flex-col">
            <span class="text-[10px] font-mono text-ink-400 uppercase tracking-widest font-semibold">DIRECT EMAIL // CLICK TO COPY</span>
            <span id="email-address" class="text-xl sm:text-2xl font-mono font-bold text-ink-950 group-hover:text-sky-600 transition-colors">
              dieuthao.tpqn@gmail.com
            </span>
          </div>
          <div class="w-10 h-10 rounded-xl bg-sky-50 border border-sky-100 group-hover:bg-sky-600 group-hover:text-white text-sky-700 flex items-center justify-center transition-all duration-300">
            <svg id="copy-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
            </svg>
            <svg id="check-icon" class="w-5 h-5 hidden text-white font-bold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
            </svg>
          </div>

          <!-- Toast Tooltip -->
          <span id="copy-toast" class="absolute -top-10 left-1/2 -translate-x-1/2 px-3 py-1 rounded bg-sky-600 text-white font-mono text-xs font-bold uppercase tracking-wider opacity-0 pointer-events-none transition-opacity duration-200 shadow-md">
            COPIED TO CLIPBOARD!
          </span>
        </button>

        <a 
          href="mailto:dieuthao.tpqn@gmail.com" 
          class="px-6 py-5 rounded-2xl bg-sky-600 hover:bg-sky-500 text-white font-mono text-sm font-bold tracking-wider uppercase flex items-center justify-center gap-2 transition-all shadow-md hover:shadow-[0_8px_20px_rgba(2,132,199,0.3)]"
          data-cursor="interactive"
        >
          <span>SEND INQUIRY</span>
          <span>→</span>
        </a>
      </div>
    </div>

    <!-- Contact Details & Verified Credentials -->
    <div class="contact-right lg:col-span-4 flex flex-col space-y-8 bg-white border border-slate-200 p-8 rounded-2xl shadow-sm">
      <div class="space-y-2">
        <span class="text-[10px] font-mono text-ink-400 uppercase tracking-widest font-semibold">LOCATION &amp; PREFERENCE</span>
        <div class="text-sm text-ink-800 font-medium">
          Danang / Ho Chi Minh / Remote <br />
          <span class="font-mono text-xs text-sky-700 font-bold">[ VIETNAM / GLOBAL REMOTE ]</span>
        </div>
      </div>

      <div class="space-y-2 border-t border-slate-100 pt-6">
        <span class="text-[10px] font-mono text-ink-400 uppercase tracking-widest font-semibold">VERIFIED CREDENTIALS</span>
        <div class="text-xs font-mono text-ink-700 space-y-2">
          <div class="flex items-start gap-2">
            <span class="text-sky-600 font-bold">✦</span>
            <span><strong>ITBA Thực Chiến: Cơ bản + Kỹ năng</strong> — UDECAREER (2026)</span>
          </div>
          <div class="flex items-start gap-2">
            <span class="text-sky-600 font-bold">✦</span>
            <span><strong>IELTS 7.5</strong> — English Proficiency (July 2026)</span>
          </div>
          <div class="flex items-start gap-2">
            <span class="text-sky-600 font-bold">✦</span>
            <span><strong>Bachelor of Arts</strong> — UFLS Danang (GPA 3.7/4.0)</span>
          </div>
        </div>
      </div>

      <div class="space-y-3 border-t border-slate-100 pt-6">
        <span class="text-[10px] font-mono text-ink-400 uppercase tracking-widest font-semibold">PORTFOLIOS &amp; PROFILES</span>
        <div class="flex flex-col space-y-2 font-mono text-xs">
          <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="group flex items-center justify-between text-ink-600 hover:text-sky-600 transition-colors py-1">
            <span>LINKEDIN PROFILE</span>
            <span class="text-ink-400 group-hover:text-sky-600">↗</span>
          </a>
          <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="group flex items-center justify-between text-ink-600 hover:text-sky-600 transition-colors py-1">
            <span>GITHUB (SQL &amp; REPOSITORIES)</span>
            <span class="text-ink-400 group-hover:text-sky-600">↗</span>
          </a>
          <a href="https://app.mokkup.ai" target="_blank" rel="noopener noreferrer" class="group flex items-center justify-between text-ink-600 hover:text-sky-600 transition-colors py-1">
            <span>MOKKUP.AI DASHBOARDS</span>
            <span class="text-ink-400 group-hover:text-sky-600">↗</span>
          </a>
          <a href="https://public.tableau.com" target="_blank" rel="noopener noreferrer" class="group flex items-center justify-between text-ink-600 hover:text-sky-600 transition-colors py-1">
            <span>TABLEAU PUBLIC PROFILE</span>
            <span class="text-ink-400 group-hover:text-sky-600">↗</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener('DOMContentLoaded', () => {
    const copyBtn = document.getElementById('copy-email-btn');
    const toast = document.getElementById('copy-toast');
    const copyIcon = document.getElementById('copy-icon');
    const checkIcon = document.getElementById('check-icon');

    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('dieuthao.tpqn@gmail.com');
        if (toast && copyIcon && checkIcon) {
          toast.classList.remove('opacity-0');
          toast.classList.add('opacity-100');
          copyIcon.classList.add('hidden');
          checkIcon.classList.remove('hidden');

          setTimeout(() => {
            toast.classList.remove('opacity-100');
            toast.classList.add('opacity-0');
            copyIcon.classList.remove('hidden');
            checkIcon.classList.add('hidden');
          }, 2200);
        }
      } catch (err) {
        console.error('Clipboard copy failed:', err);
      }
    });

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: '#contact',
        start: 'top 80%',
        toggleActions: 'play none none none',
        once: true,
      },
    });

    tl.from('.contact-header', {
      y: 35,
      autoAlpha: 0,
      duration: 0.8,
      ease: 'power3.out',
      clearProps: 'transform,opacity,visibility',
    })
    .from('.contact-left', {
      y: 35,
      autoAlpha: 0,
      duration: 0.85,
      ease: 'power3.out',
      clearProps: 'transform,opacity,visibility',
    }, '-=0.5')
    .from('.contact-right', {
      y: 35,
      autoAlpha: 0,
      duration: 0.85,
      ease: 'power3.out',
      clearProps: 'transform,opacity,visibility',
    }, '-=0.65');
  });
</script>
