---
---
<section id="contact" class="py-24 sm:py-36 px-6 lg:px-12 bg-[#06152b] text-white relative overflow-hidden border-t border-[#122840]">
  <div class="max-w-[1440px] mx-auto">
    <!-- Header in Midnight Sky Blue tone -->
    <div class="contact-header border-b border-[#122840] pb-8 mb-16 flex flex-col md:flex-row md:items-end justify-between gap-6">
      <div class="space-y-3">
        <div class="flex items-center gap-2 text-xs font-mono tracking-widest text-[#7ca6ce] font-bold uppercase">
          <span class="w-1.5 h-1.5 rounded-full bg-[#38bdf8] animate-pulse"></span>
          <span>&#123; 05 &#125; RECRUITMENT &amp; CONTACT</span>
        </div>
        <h2 class="text-4xl sm:text-6xl md:text-7xl font-semibold tracking-tight text-white uppercase">
          LET'S CONNECT
        </h2>
      </div>
      <div class="text-xs font-mono text-[#7ca6ce]">
        <span class="text-[#38bdf8] font-bold">// AVAILABILITY:</span> INTERNSHIP &amp; JUNIOR BA ROLES (2026)
      </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
      <!-- Big Headline Callout -->
      <div class="contact-left lg:col-span-8 space-y-8">
        <div class="space-y-4">
          <h3 class="text-4xl sm:text-6xl md:text-7xl font-semibold text-white tracking-tight leading-[1.05]">
            Looking for a driven <br />
            <span class="font-serif italic font-normal text-sky-300 text-5xl sm:text-7xl md:text-8xl">Business Analyst</span> Intern?
          </h3>
          <p class="text-lg sm:text-xl text-[#93b7db] max-w-xl leading-relaxed pt-2">
            I am actively seeking Business Analyst Intern, Product Analyst, and Associate ITBA positions. Ready to contribute with structured requirements, wireframes, and data analysis.
          </p>
        </div>

        <!-- Interactive Copy Email Box in Sky Blue styling -->
        <div class="pt-4 flex flex-col sm:flex-row sm:items-center gap-4">
          <button 
            id="copy-email-btn"
            class="group relative inline-flex items-center justify-between gap-6 px-6 sm:px-8 py-5 bg-[#091e38] border border-[#143354] hover:border-[#38bdf8] text-left transition-colors duration-300 cursor-pointer shadow-lg"
            data-cursor="interactive"
          >
            <div class="flex flex-col">
              <span class="text-[10px] font-mono text-[#6287aa] uppercase tracking-widest font-semibold">DIRECT EMAIL // CLICK TO COPY</span>
              <span id="email-address" class="text-xl sm:text-2xl font-mono font-bold text-white group-hover:text-sky-200 transition-colors">
                dieuthao.tpqn@gmail.com
              </span>
            </div>
            <div class="w-10 h-10 border border-[#143354] group-hover:border-[#38bdf8] bg-[#0c2443] group-hover:bg-[#0284c7] group-hover:text-white text-sky-300 flex items-center justify-center transition-all duration-300">
              <svg id="copy-icon" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
              </svg>
              <svg id="check-icon" class="w-4 h-4 hidden text-white font-bold" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path>
              </svg>
            </div>

            <!-- Toast Tooltip -->
            <span id="copy-toast" class="absolute -top-10 left-1/2 -translate-x-1/2 px-3 py-1 bg-[#0284c7] text-white font-mono text-xs font-bold uppercase tracking-wider opacity-0 pointer-events-none transition-opacity duration-200 shadow-md">
              COPIED TO CLIPBOARD!
            </span>
          </button>

          <a 
            href="mailto:dieuthao.tpqn@gmail.com" 
            class="px-6 py-5 border border-[#0284c7] bg-[#0284c7] hover:bg-[#0369a1] text-white font-mono text-sm font-bold tracking-wider uppercase flex items-center justify-center gap-2 transition-all duration-300 shadow-lg"
            data-cursor="interactive"
          >
            <span>SEND INQUIRY</span>
            <span>→</span>
          </a>
        </div>
      </div>

      <!-- Contact Details & Verified Credentials -->
      <div class="contact-right lg:col-span-4 flex flex-col space-y-8 bg-[#091e38] border border-[#143354] p-8 shadow-xl">
        <div class="space-y-2">
          <span class="text-[10px] font-mono text-[#6287aa] uppercase tracking-widest font-semibold">LOCATION &amp; PREFERENCE</span>
          <div class="text-sm text-[#d2e4f5]">
            Danang / Ho Chi Minh / Remote <br />
            <span class="font-mono text-xs text-sky-300 font-bold">[ VIETNAM / GLOBAL REMOTE ]</span>
          </div>
        </div>

        <div class="space-y-2 border-t border-[#143354] pt-6">
          <span class="text-[10px] font-mono text-[#6287aa] uppercase tracking-widest font-semibold">VERIFIED CREDENTIALS</span>
          <div class="text-xs font-mono text-[#a5c5e6] space-y-2">
            <div class="flex items-start gap-2">
              <span class="text-[#38bdf8]">✦</span>
              <span><strong class="text-white">ITBA Thực Chiến</strong> — UDECAREER (2026)</span>
            </div>
            <div class="flex items-start gap-2">
              <span class="text-[#38bdf8]">✦</span>
              <span><strong class="text-white">IELTS 7.5</strong> — English (July 2026)</span>
            </div>
            <div class="flex items-start gap-2">
              <span class="text-[#38bdf8]">✦</span>
              <span><strong class="text-white">Bachelor of Arts</strong> — UFLS (GPA 3.7/4.0)</span>
            </div>
          </div>
        </div>

        <div class="space-y-3 border-t border-[#143354] pt-6">
          <span class="text-[10px] font-mono text-[#6287aa] uppercase tracking-widest font-semibold">PROFILES &amp; REPOSITORIES</span>
          <div class="flex flex-col space-y-2 font-mono text-xs">
            <a href="https://linkedin.com" target="_blank" rel="noopener noreferrer" class="group flex items-center justify-between text-[#8bb2d6] hover:text-[#38bdf8] transition-colors py-1">
              <span>LINKEDIN</span>
              <span class="text-[#51769c] group-hover:text-[#38bdf8]">↗</span>
            </a>
            <a href="https://github.com" target="_blank" rel="noopener noreferrer" class="group flex items-center justify-between text-[#8bb2d6] hover:text-[#38bdf8] transition-colors py-1">
              <span>GITHUB</span>
              <span class="text-[#51769c] group-hover:text-[#38bdf8]">↗</span>
            </a>
            <a href="https://app.mokkup.ai" target="_blank" rel="noopener noreferrer" class="group flex items-center justify-between text-[#8bb2d6] hover:text-[#38bdf8] transition-colors py-1">
              <span>MOKKUP.AI</span>
              <span class="text-[#51769c] group-hover:text-[#38bdf8]">↗</span>
            </a>
            <a href="https://public.tableau.com" target="_blank" rel="noopener noreferrer" class="group flex items-center justify-between text-[#8bb2d6] hover:text-[#38bdf8] transition-colors py-1">
              <span>TABLEAU PUBLIC</span>
              <span class="text-[#51769c] group-hover:text-[#38bdf8]">↗</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener('DOMContentLoaded', () => {
    const copyBtn = document.getElementById('copy-email-btn');
    const toast = document.getElementById('copy-toast');
    const copyIcon = document.getElementById('copy-icon');
    const checkIcon = document.getElementById('check-icon');

    copyBtn?.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText('dieuthao.tpqn@gmail.com');
        if (toast && copyIcon && checkIcon) {
          toast.classList.remove('opacity-0');
          toast.classList.add('opacity-100');
          copyIcon.classList.add('hidden');
          checkIcon.classList.remove('hidden');

          setTimeout(() => {
            toast.classList.remove('opacity-100');
            toast.classList.add('opacity-0');
            copyIcon.classList.remove('hidden');
            checkIcon.classList.add('hidden');
          }, 2200);
        }
      } catch (err) {
        console.error('Clipboard copy failed:', err);
      }
    });

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: '#contact',
        start: 'top 80%',
        toggleActions: 'play none none none',
        once: true,
      },
    });

    tl.from('.contact-header', {
      y: 35,
      autoAlpha: 0,
      duration: 0.8,
      ease: 'power3.out',
      clearProps: 'all',
    })
    .from('.contact-left', {
      y: 35,
      autoAlpha: 0,
      duration: 0.85,
      ease: 'power3.out',
      clearProps: 'all',
    }, '-=0.5')
    .from('.contact-right', {
      y: 35,
      autoAlpha: 0,
      duration: 0.85,
      ease: 'power3.out',
      clearProps: 'all',
    }, '-=0.65');
  });
</script>
