---
---
<section id="home" class="relative min-h-[92vh] flex flex-col justify-between pt-32 pb-12 px-6 lg:px-12 max-w-7xl mx-auto overflow-hidden">
  <!-- Subtle ambient background radial glow -->
  <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[700px] h-[700px] bg-brand-500/10 rounded-full blur-[140px] pointer-events-none -z-10"></div>

  <!-- Top Hero Content -->
  <div class="flex flex-col space-y-8 my-auto">
    <!-- Role pill & status -->
    <div class="hero-anim-item flex items-center gap-3">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-brand-neon/30 bg-brand-neon/5 text-brand-neon font-mono text-xs tracking-wider uppercase">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-neon animate-pulse"></span>
        <span>CREATIVE DEVELOPER &amp; PRODUCT DESIGNER</span>
      </div>
      <span class="hidden sm:inline-block text-zinc-600 font-mono text-xs">// LONDON / REMOTE</span>
    </div>

    <!-- Massive Typographic Headline -->
    <div class="space-y-1 sm:space-y-2">
      <div class="overflow-hidden">
        <h1 class="hero-title-1 text-5xl sm:text-7xl md:text-8xl lg:text-[7.5rem] font-bold tracking-tight text-white uppercase leading-[0.92]">
          FUNCTIONALITY
        </h1>
      </div>
      <div class="overflow-hidden">
        <h2 class="hero-title-2 text-5xl sm:text-7xl md:text-8xl lg:text-[7.5rem] font-bold tracking-tight text-white uppercase leading-[0.92] flex items-center flex-wrap gap-x-4">
          <span class="font-serif italic font-normal text-brand-neon lowercase text-6xl sm:text-8xl md:text-9xl lg:text-[8.5rem] leading-none transform -rotate-3">&amp;</span>
          <span class="bg-gradient-to-r from-white via-zinc-200 to-zinc-400 bg-clip-text text-transparent">AESTHETICS</span>
        </h2>
      </div>
    </div>

    <!-- Bio introduction statement -->
    <div class="hero-anim-item max-w-2xl pt-4">
      <p class="text-lg sm:text-2xl text-zinc-400 font-light leading-relaxed">
        I am a Designer &amp; Engineer specialising in crafting bold digital experiences that unite technical excellence with high-concept design.
      </p>
    </div>
  </div>

  <!-- Bottom Hero Bar: Scroll indicator + Client roster -->
  <div class="hero-anim-item border-t border-white/10 pt-8 mt-12 flex flex-col md:flex-row md:items-center justify-between gap-6 font-mono text-xs text-zinc-500">
    <!-- Scroll prompt -->
    <a href="#work" class="group flex items-center gap-3 text-zinc-400 hover:text-brand-neon transition-colors w-fit">
      <div class="w-8 h-8 rounded-full border border-zinc-800 group-hover:border-brand-neon flex items-center justify-center transition-colors">
        <svg class="w-4 h-4 text-brand-neon group-hover:translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </div>
      <span class="tracking-widest uppercase">&#123; SCROLL TO EXPLORE &#125;</span>
    </a>

    <!-- Client / Partner marquee pills -->
    <div class="flex items-center gap-6 sm:gap-8 flex-wrap">
      <span class="text-zinc-600 uppercase tracking-widest text-[10px]">SELECTED CLIENTS:</span>
      <div class="flex items-center gap-4 sm:gap-6 text-zinc-400 font-semibold tracking-wider text-xs">
        <span class="hover:text-brand-neon transition-colors">TRG</span>
        <span class="text-zinc-700">/</span>
        <span class="hover:text-brand-neon transition-colors">VERIZON</span>
        <span class="text-zinc-700">/</span>
        <span class="hover:text-brand-neon transition-colors">BT</span>
        <span class="text-zinc-700">/</span>
        <span class="hover:text-brand-neon transition-colors">NIELSEN</span>
        <span class="text-zinc-700">/</span>
        <span class="hover:text-brand-neon transition-colors">PNC</span>
        <span class="text-zinc-700">/</span>
        <span class="hover:text-brand-neon transition-colors">TRM</span>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';

  function initHeroAnimations() {
    const tl = gsap.timeline();

    tl.from('.hero-title-1', {
      yPercent: 120,
      duration: 1.1,
      ease: 'power4.out',
      delay: 0.1,
    })
    .from('.hero-title-2', {
      yPercent: 120,
      duration: 1.1,
      ease: 'power4.out',
    }, '-=0.9')
    .from('.hero-anim-item', {
      y: 35,
      opacity: 0,
      stagger: 0.15,
      duration: 0.8,
      ease: 'power3.out',
    }, '-=0.7');
  }

  // Listen to preloader event or trigger immediately if already loaded
  if (sessionStorage.getItem('serah_loaded')) {
    initHeroAnimations();
  } else {
    window.addEventListener('preloaderDone', initHeroAnimations);
  }
</script>
