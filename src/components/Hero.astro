---
---
<section id="home" class="relative min-h-[92vh] flex flex-col justify-between pt-32 pb-12 px-6 lg:px-12 max-w-7xl mx-auto overflow-hidden">
  <!-- Subtle ambient background sky radial glow -->
  <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[700px] h-[700px] rounded-full pointer-events-none -z-10" style="background: radial-gradient(circle, rgba(56, 189, 248, 0.15) 0%, transparent 70%);"></div>

  <!-- Top Hero Content -->
  <div class="flex flex-col space-y-8 my-auto">
    <!-- Role pill & status -->
    <div class="hero-anim-item flex items-center gap-3">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full border border-sky-200 bg-sky-50 text-sky-700 font-mono text-xs tracking-wider uppercase shadow-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-sky-500 animate-pulse"></span>
        <span class="font-bold">BUSINESS ANALYST INTERN // DATA &amp; PROCESS STRATEGY</span>
      </div>
      <span class="hidden sm:inline-block text-ink-400 font-mono text-xs">// ECBA CANDIDATE · 2026</span>
    </div>

    <!-- Massive Typographic Headline -->
    <div class="space-y-1 sm:space-y-2">
      <div class="overflow-hidden">
        <h1 class="hero-title-1 text-5xl sm:text-7xl md:text-8xl lg:text-[7.5rem] font-bold tracking-tight text-ink-950 uppercase leading-[0.92]">
          BUSINESS LOGIC
        </h1>
      </div>
      <div class="overflow-hidden">
        <h2 class="hero-title-2 text-5xl sm:text-7xl md:text-8xl lg:text-[7.5rem] font-bold tracking-tight text-ink-950 uppercase leading-[0.92] flex items-center flex-wrap gap-x-4">
          <span class="font-serif italic font-normal text-sky-600 lowercase text-6xl sm:text-8xl md:text-9xl lg:text-[8.5rem] leading-none transform -rotate-3">&amp;</span>
          <span class="bg-gradient-to-r from-ink-950 via-ink-800 to-slate-700 bg-clip-text text-transparent">DATA INSIGHTS</span>
        </h2>
      </div>
    </div>

    <!-- Bio introduction statement -->
    <div class="hero-anim-item max-w-2xl pt-4">
      <p class="text-lg sm:text-2xl text-ink-600 font-light leading-relaxed">
        Translating complex stakeholder needs into actionable requirements, interactive BI dashboard wireframes, and measurable process improvements.
      </p>
    </div>
  </div>

  <!-- Bottom Hero Bar: Scroll indicator + Core domains -->
  <div class="hero-anim-item border-t border-slate-200 pt-8 mt-12 flex flex-col md:flex-row md:items-center justify-between gap-6 font-mono text-xs text-ink-500">
    <!-- Scroll prompt -->
    <a href="#projects" class="group flex items-center gap-3 text-ink-600 hover:text-sky-600 transition-colors w-fit">
      <div class="w-8 h-8 rounded-full border border-slate-300 group-hover:border-sky-500 group-hover:bg-sky-50 flex items-center justify-center transition-colors">
        <svg class="w-4 h-4 text-sky-600 group-hover:translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </div>
      <span class="tracking-widest uppercase font-semibold">&#123; EXPLORE CASE STUDIES &#125;</span>
    </a>

    <!-- Core BA Focus Areas -->
    <div class="flex items-center gap-6 sm:gap-8 flex-wrap">
      <span class="text-ink-400 uppercase tracking-widest text-[10px] font-bold">CORE DOMAINS:</span>
      <div class="flex items-center gap-4 sm:gap-6 text-ink-600 font-semibold tracking-wider text-xs">
        <span class="hover:text-sky-600 transition-colors">REQUIREMENTS (BRD)</span>
        <span class="text-slate-300">/</span>
        <span class="hover:text-sky-600 transition-colors">DASHBOARDS</span>
        <span class="text-slate-300">/</span>
        <span class="hover:text-sky-600 transition-colors">SQL QUERYING</span>
        <span class="text-slate-300">/</span>
        <span class="hover:text-sky-600 transition-colors">BPMN FLOWS</span>
        <span class="text-slate-300">/</span>
        <span class="hover:text-sky-600 transition-colors">AGILE JIRA</span>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';

  function initHeroAnimations() {
    if ((window as any)._heroAnimated) return;
    (window as any)._heroAnimated = true;

    const tl = gsap.timeline();

    tl.from('.hero-title-1', {
      yPercent: 120,
      duration: 1.15,
      ease: 'expo.out',
      clearProps: 'transform',
    })
    .from('.hero-title-2', {
      yPercent: 120,
      duration: 1.15,
      ease: 'expo.out',
      clearProps: 'transform',
    }, '-=0.95')
    .from('.hero-anim-item', {
      y: 25,
      autoAlpha: 0,
      stagger: 0.1,
      duration: 0.85,
      ease: 'power3.out',
      clearProps: 'transform,opacity,visibility',
    }, '-=0.75');
  }

  window.addEventListener('DOMContentLoaded', () => {
    if (sessionStorage.getItem('dieuthao_loaded')) {
      initHeroAnimations();
    } else {
      window.addEventListener('preloaderDone', initHeroAnimations, { once: true });
    }
  });
</script>
