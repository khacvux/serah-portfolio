---
---
<section id="home" class="relative min-h-[92vh] flex flex-col justify-between pt-32 pb-12 px-6 lg:px-12 max-w-[1440px] mx-auto overflow-hidden">
  <!-- Top Hero Content -->
  <div class="flex flex-col space-y-8 my-auto pt-6">
    <!-- Role pill & status -->
    <div class="hero-anim-item flex items-center gap-3">
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 border border-[#d5e7f5] bg-white text-[#091e36] font-mono text-xs tracking-wider uppercase shadow-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-[#0ea5e9] animate-pulse"></span>
        <span class="font-bold">BUSINESS ANALYST // DATA &amp; PROCESS STRATEGY</span>
      </div>
      <span class="hidden sm:inline-block text-[#5a7894] font-mono text-xs">&#123; ECBA CANDIDATE · 2026 &#125;</span>
    </div>

    <!-- Massive Typographic Headline matching Jack Elder in Sky Blue tone -->
    <div class="space-y-1 sm:space-y-2">
      <div class="overflow-hidden">
        <h1 class="hero-title-1 text-5xl sm:text-7xl md:text-8xl lg:text-[7.5rem] font-semibold tracking-tight text-[#091e36] uppercase leading-[0.92]">
          BUSINESS LOGIC
        </h1>
      </div>
      <div class="overflow-hidden">
        <h2 class="hero-title-2 text-5xl sm:text-7xl md:text-8xl lg:text-[7.5rem] font-semibold tracking-tight text-[#091e36] uppercase leading-[0.92] flex items-center flex-wrap gap-x-4">
          <span class="font-serif italic font-normal text-[#0284c7] lowercase text-6xl sm:text-8xl md:text-9xl lg:text-[8.5rem] leading-none transform -rotate-2">&amp;</span>
          <span>DATA INSIGHTS</span>
        </h2>
      </div>
    </div>

    <!-- Statement with signature Mazius Display sky blue italic accents -->
    <div class="hero-anim-item max-w-3xl pt-4">
      <p class="text-xl sm:text-2xl md:text-3xl text-[#1e3852] font-normal leading-relaxed">
        I am an analyst <span class="font-serif italic text-2xl sm:text-3xl md:text-4xl text-[#0284c7] font-medium">specialising</span> in translating complex stakeholder needs into actionable requirements, interactive BI dashboards, and digital <span class="font-serif italic text-2xl sm:text-3xl md:text-4xl text-[#0284c7] font-medium">experiences</span>.
      </p>
    </div>
  </div>

  <!-- Bottom Hero Bar: Scroll indicator + Core domains -->
  <div class="hero-anim-item border-t border-[#d5e7f5] pt-8 mt-12 flex flex-col md:flex-row md:items-center justify-between gap-6 font-mono text-xs text-[#5a7894]">
    <!-- Scroll prompt with Sky Blue interactive accents -->
    <a href="#projects" class="group flex items-center gap-3 text-[#091e36] transition-colors w-fit" data-cursor="interactive">
      <div class="w-8 h-8 rounded-full border border-[#0284c7] text-[#0284c7] group-hover:bg-[#0284c7] group-hover:text-white flex items-center justify-center transition-all duration-300">
        <svg class="w-3.5 h-3.5 group-hover:translate-y-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </div>
      <span class="tracking-widest uppercase font-semibold text-[#091e36] group-hover:text-[#0284c7] transition-colors">&#123; SCROLL &#125;</span>
    </a>

    <!-- Core BA Focus Areas -->
    <div class="flex items-center gap-6 sm:gap-8 flex-wrap">
      <span class="text-[#5a7894] uppercase tracking-widest text-[10px] font-bold">CORE FOCUS:</span>
      <div class="flex items-center gap-4 sm:gap-6 text-[#1e3852] font-semibold tracking-wider text-xs">
        <span class="hover:text-[#0284c7] transition-colors">REQUIREMENTS (BRD)</span>
        <span class="text-[#d5e7f5]">/</span>
        <span class="hover:text-[#0284c7] transition-colors">DASHBOARDS</span>
        <span class="text-[#d5e7f5]">/</span>
        <span class="hover:text-[#0284c7] transition-colors">SQL QUERYING</span>
        <span class="text-[#d5e7f5]">/</span>
        <span class="hover:text-[#0284c7] transition-colors">BPMN 2.0</span>
        <span class="text-[#d5e7f5]">/</span>
        <span class="hover:text-[#0284c7] transition-colors">AGILE JIRA</span>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';

  function initHeroAnimations() {
    if ((window as any)._heroAnimated) return;
    (window as any)._heroAnimated = true;

    const tl = gsap.timeline();

    tl.from('.hero-title-1', {
      yPercent: 120,
      duration: 1.15,
      ease: 'expo.out',
      clearProps: 'transform',
    })
    .from('.hero-title-2', {
      yPercent: 120,
      duration: 1.15,
      ease: 'expo.out',
      clearProps: 'transform',
    }, '-=0.95')
    .from('.hero-anim-item', {
      y: 25,
      autoAlpha: 0,
      stagger: 0.1,
      duration: 0.85,
      ease: 'power3.out',
      clearProps: 'transform,opacity,visibility',
    }, '-=0.75');
  }

  window.addEventListener('DOMContentLoaded', () => {
    if (sessionStorage.getItem('dieuthao_loaded')) {
      initHeroAnimations();
    } else {
      window.addEventListener('preloaderDone', initHeroAnimations, { once: true });
    }
  });
</script>
