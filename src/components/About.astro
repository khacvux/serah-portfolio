---
---
<section id="about" class="py-24 sm:py-32 px-6 lg:px-12 max-w-7xl mx-auto">
  <!-- Section Title Header -->
  <div class="about-header border-b border-slate-200 pb-8 mb-16 flex flex-col md:flex-row md:items-end justify-between gap-6">
    <div class="space-y-3">
      <div class="flex items-center gap-2 text-xs font-mono tracking-widest text-sky-600 font-bold uppercase">
        <span class="w-1.5 h-1.5 rounded-full bg-sky-500"></span>
        <span>&#123; 02 / PROFILE &amp; OBJECTIVE &#125;</span>
      </div>
      <h2 class="text-4xl sm:text-6xl font-bold tracking-tight text-ink-950 uppercase">
        ABOUT DIỆU THẢO
      </h2>
    </div>
    <div class="text-xs font-mono text-ink-500">
      <span class="text-ink-400">// FOCUS</span> IT BUSINESS ANALYSIS · DATA · PROCESS MODELING
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
    <!-- Left Column: Portrait & Stats -->
    <div class="about-photo-col lg:col-span-5 flex flex-col space-y-6">
      <div class="relative rounded-2xl overflow-hidden border border-slate-200 bg-white shadow-sm group">
        <img 
          src="/assets/projects/profile.jpg" 
          alt="Diệu Thảo - Business Analyst Intern" 
          class="w-full aspect-[4/5] object-cover object-center filter grayscale contrast-105 group-hover:grayscale-0 transition-all duration-700 ease-out"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-sky-900/10 mix-blend-color pointer-events-none"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent pointer-events-none"></div>

        <!-- Floating badge on image -->
        <div class="absolute bottom-6 left-6 right-6 p-4 rounded-xl bg-white/95 backdrop-blur-md border border-slate-200 shadow-md flex items-center justify-between">
          <div class="flex flex-col">
            <span class="text-xs font-mono tracking-wider text-sky-700 font-bold">ITBA CERTIFIED &amp; IELTS 7.5</span>
            <span class="text-xs text-ink-600 font-medium">UFLS - University of Danang (GPA 3.7/4)</span>
          </div>
          <div class="w-2.5 h-2.5 rounded-full bg-sky-500 animate-pulse"></div>
        </div>
      </div>

      <!-- Quick stats bar -->
      <div class="grid grid-cols-3 gap-3 font-mono text-center">
        <div class="p-3.5 rounded-xl bg-white border border-slate-200 shadow-sm">
          <div class="text-xl sm:text-2xl font-bold text-ink-950">3.7<span class="text-xs text-ink-400 font-normal">/4.0</span></div>
          <div class="text-[10px] text-ink-500 uppercase mt-0.5 font-semibold">Final GPA</div>
        </div>
        <div class="p-3.5 rounded-xl bg-white border border-slate-200 shadow-sm">
          <div class="text-xl sm:text-2xl font-bold text-sky-600">7.5</div>
          <div class="text-[10px] text-ink-500 uppercase mt-0.5 font-semibold">IELTS Band</div>
        </div>
        <div class="p-3.5 rounded-xl bg-white border border-slate-200 shadow-sm">
          <div class="text-xl sm:text-2xl font-bold text-ink-950">ITBA</div>
          <div class="text-[10px] text-ink-500 uppercase mt-0.5 font-semibold">UDECAREER</div>
        </div>
      </div>
    </div>

    <!-- Right Column: Biography & Statement -->
    <div class="about-text-col lg:col-span-7 flex flex-col space-y-8">
      <!-- Big Statement -->
      <div class="space-y-4">
        <h3 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-ink-950 leading-tight">
          Combining strong analytical rigor, international communication skills, and practical ITBA methodologies.
        </h3>
        <p class="text-base sm:text-lg text-ink-600 leading-relaxed font-light">
          Graduated with a Bachelor of Arts from <strong>The University of Danang - University of Foreign Language Studies</strong> (Final GPA: <strong>3.7/4.0</strong>), backed by an <strong>IELTS 7.5</strong> language proficiency and certified IT Business Analysis training from <strong>UDECAREER</strong>.
        </p>
      </div>

      <!-- Detailed paragraphs -->
      <div class="space-y-5 text-ink-600 leading-relaxed text-sm sm:text-base border-t border-slate-200 pt-8">
        <p>
          Trained in practical IT Business Analysis (<em>ITBA Thực Chiến: Cơ bản + Kỹ năng ITBA</em>), I possess hands-on capability in requirement elicitation, backlog management, drafting detailed User Stories with Acceptance Criteria, and mapping AS-IS vs. TO-BE business workflows with BPMN 2.0.
        </p>
        <p>
          Following modern BA standards, I leverage <strong>Mokkup.ai</strong> for rapid dashboard wireframing to clarify KPIs and reporting structures with stakeholders before writing SQL queries or building BI reports in Power BI and Tableau.
        </p>
        <p>
          With fluent bilingual communication (IELTS 7.5), a 3.7 GPA track record, and a structured problem-solving approach, I am seeking a <strong>Business Analyst Intern</strong> role to bridge stakeholder vision with engineering execution.
        </p>
      </div>

      <!-- Action: Download CV / Contact -->
      <div class="pt-4 flex flex-wrap items-center gap-4">
        <a 
          href="/assets/resume.pdf" 
          target="_blank"
          class="magnetic-btn px-6 py-3.5 rounded-full bg-sky-600 hover:bg-sky-500 text-white font-mono text-xs font-bold tracking-wider uppercase flex items-center gap-3 transition-all duration-300 shadow-md hover:shadow-[0_8px_20px_rgba(2,132,199,0.3)]"
          data-cursor="interactive"
        >
          <span>DOWNLOAD RESUME (CV)</span>
          <svg class="w-4 h-4 transform group-hover:translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </a>

        <a 
          href="#contact" 
          class="px-6 py-3.5 rounded-full bg-white border border-slate-200 hover:border-sky-400 text-ink-700 hover:text-sky-700 font-mono text-xs tracking-wider uppercase transition-colors shadow-sm"
          data-cursor="interactive"
        >
          GET IN TOUCH →
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener('DOMContentLoaded', () => {
    const mm = gsap.matchMedia();

    mm.add({
      isDesktop: '(min-width: 1024px)',
      isMobile: '(max-width: 1023px)',
    }, (context) => {
      const { isDesktop } = context.conditions;
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: '#about',
          start: 'top 80%',
          toggleActions: 'play none none none',
          once: true,
        },
      });

      tl.from('.about-header', {
        y: 35,
        autoAlpha: 0,
        duration: 0.8,
        ease: 'power3.out',
        clearProps: 'all',
      })
      .from('.about-photo-col', {
        x: isDesktop ? -30 : 0,
        y: isDesktop ? 0 : 30,
        autoAlpha: 0,
        duration: 0.85,
        ease: 'power3.out',
        clearProps: 'all',
      }, '-=0.5')
      .from('.about-text-col', {
        x: isDesktop ? 30 : 0,
        y: isDesktop ? 0 : 30,
        autoAlpha: 0,
        duration: 0.85,
        ease: 'power3.out',
        clearProps: 'all',
      }, '-=0.65');
    });
  });
</script>
