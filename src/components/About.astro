---
---
<section id="about" class="py-24 sm:py-32 px-6 lg:px-12 max-w-7xl mx-auto">
  <!-- Section Title Header -->
  <div class="about-header border-b border-white/10 pb-8 mb-16 flex flex-col md:flex-row md:items-end justify-between gap-6">
    <div class="space-y-3">
      <div class="flex items-center gap-2 text-xs font-mono tracking-widest text-brand-neon uppercase">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-neon"></span>
        <span>&#123; 02 / ABOUT &amp; PROFILE &#125;</span>
      </div>
      <h2 class="text-4xl sm:text-6xl font-bold tracking-tight text-white uppercase">
        BEHIND THE CRAFT
      </h2>
    </div>
    <div class="text-xs font-mono text-zinc-400">
      <span class="text-zinc-600">// CORE PHILOSOPHY</span> HUMAN-CENTRIC &amp; SYSTEMATIC
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
    <!-- Left Column: Portrait & Stats -->
    <div class="about-photo-col lg:col-span-5 flex flex-col space-y-6">
      <div class="relative rounded-2xl overflow-hidden border border-white/10 bg-dark-900 group">
        <img 
          src="/assets/projects/profile.jpg" 
          alt="Serah - Creative Developer & Designer" 
          class="w-full aspect-[4/5] object-cover object-center filter grayscale contrast-110 group-hover:grayscale-0 transition-all duration-700 ease-out"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-brand-950/20 mix-blend-color pointer-events-none"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-dark-950/90 via-transparent to-transparent pointer-events-none"></div>

        <!-- Floating badge on image -->
        <div class="absolute bottom-6 left-6 right-6 p-4 rounded-xl bg-dark-950/85 backdrop-blur-md border border-white/10 flex items-center justify-between">
          <div class="flex flex-col">
            <span class="text-xs font-mono tracking-wider text-brand-neon font-bold">10+ YEARS EXPERIENCE</span>
            <span class="text-xs text-zinc-400">Digital Product &amp; Engineering</span>
          </div>
          <div class="w-2.5 h-2.5 rounded-full bg-brand-neon animate-pulse"></div>
        </div>
      </div>

      <!-- Quick stats bar -->
      <div class="grid grid-cols-3 gap-3 font-mono text-center">
        <div class="p-3 rounded-xl bg-dark-900 border border-white/5">
          <div class="text-xl sm:text-2xl font-bold text-white">40+</div>
          <div class="text-[10px] text-zinc-500 uppercase mt-0.5">Projects</div>
        </div>
        <div class="p-3 rounded-xl bg-dark-900 border border-white/5">
          <div class="text-xl sm:text-2xl font-bold text-brand-neon">10+</div>
          <div class="text-[10px] text-zinc-500 uppercase mt-0.5">Years</div>
        </div>
        <div class="p-3 rounded-xl bg-dark-900 border border-white/5">
          <div class="text-xl sm:text-2xl font-bold text-white">100%</div>
          <div class="text-[10px] text-zinc-500 uppercase mt-0.5">Dedication</div>
        </div>
      </div>
    </div>

    <!-- Right Column: Biography & Statement -->
    <div class="about-text-col lg:col-span-7 flex flex-col space-y-8">
      <!-- Big Statement -->
      <div class="space-y-4">
        <h3 class="text-2xl sm:text-3xl md:text-4xl font-bold tracking-tight text-white leading-tight">
          I pair strong visual design skills with a deep passion for clean, high-performance code.
        </h3>
        <p class="text-base sm:text-lg text-zinc-400 leading-relaxed font-light">
          For over a decade, I have been striving to create bold experiences that connect brands with their audiences through design that truly resonates.
        </p>
      </div>

      <!-- Detailed paragraphs -->
      <div class="space-y-5 text-zinc-400 leading-relaxed text-sm sm:text-base border-t border-white/10 pt-8">
        <p>
          Specializing in experience design, art direction, and digital engineering, I strive to give each project a distinct personality and visual identity. From enterprise applications to immersive brand destinations, every interface is crafted with obsessive attention to typography, micro-interactions, and motion choreography.
        </p>
        <p>
          Throughout my career, I’ve had the privilege of working with some remarkably talented people across global agencies and high-growth technology companies—including Born Group, W12 Studios, and MullenLowe.
        </p>
        <p>
          I believe exceptional digital products are born at the intersection where brutal functionality meets uncompromising aesthetics.
        </p>
      </div>

      <!-- Action: Download CV / Contact -->
      <div class="pt-4 flex flex-wrap items-center gap-4">
        <a 
          href="/assets/cv.pdf" 
          target="_blank"
          class="magnetic-btn px-6 py-3.5 rounded-full bg-brand-neon text-dark-950 font-mono text-xs font-bold tracking-wider uppercase flex items-center gap-3 hover:bg-brand-400 transition-all duration-300 shadow-[0_0_20px_rgba(0,255,135,0.3)] hover:shadow-[0_0_30px_rgba(0,255,135,0.6)]"
          data-cursor="interactive"
        >
          <span>DOWNLOAD CV</span>
          <svg class="w-4 h-4 transform group-hover:translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </a>

        <a 
          href="#contact" 
          class="px-6 py-3.5 rounded-full bg-dark-900 border border-white/10 hover:border-brand-neon/40 text-zinc-300 hover:text-white font-mono text-xs tracking-wider uppercase transition-colors"
          data-cursor="interactive"
        >
          GET IN TOUCH →
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener('DOMContentLoaded', () => {
    gsap.from('.about-header', {
      scrollTrigger: {
        trigger: '.about-header',
        start: 'top 85%',
        toggleActions: 'play none none none',
      },
      y: 40,
      opacity: 0,
      duration: 0.8,
      ease: 'power3.out',
    });

    gsap.from('.about-photo-col', {
      scrollTrigger: {
        trigger: '.about-photo-col',
        start: 'top 80%',
        toggleActions: 'play none none none',
      },
      x: -40,
      opacity: 0,
      duration: 0.9,
      ease: 'power3.out',
    });

    gsap.from('.about-text-col', {
      scrollTrigger: {
        trigger: '.about-text-col',
        start: 'top 80%',
        toggleActions: 'play none none none',
      },
      x: 40,
      opacity: 0,
      duration: 0.9,
      ease: 'power3.out',
    });
  });
</script>
