---
---
<section id="about" class="py-24 sm:py-32 px-6 lg:px-12 max-w-[1440px] mx-auto">
  <!-- Section Title Header in Sky Blue tone -->
  <div class="about-header border-b border-[#d5e7f5] pb-8 mb-16 flex flex-col md:flex-row md:items-end justify-between gap-6">
    <div class="space-y-3">
      <div class="flex items-center gap-2 text-xs font-mono tracking-widest text-[#5a7894] font-bold uppercase">
        <span class="w-1.5 h-1.5 rounded-full bg-[#0ea5e9]"></span>
        <span>&#123; 02 &#125; PROFILE &amp; OBJECTIVE</span>
      </div>
      <h2 class="text-4xl sm:text-6xl md:text-7xl font-semibold tracking-tight text-[#091e36] uppercase">
        ABOUT DIỆU THẢO
      </h2>
    </div>
    <div class="text-xs font-mono text-[#5a7894]">
      <span class="text-[#0284c7] font-bold">// FOCUS:</span> IT BUSINESS ANALYSIS · DATA · PROCESS MODELING
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
    <!-- Left Column: Portrait & Stats -->
    <div class="about-photo-col lg:col-span-5 flex flex-col space-y-6">
      <div class="relative overflow-hidden border border-[#d5e7f5] bg-white group shadow-sm">
        <img 
          src="/assets/projects/profile.jpg" 
          alt="Diệu Thảo - Business Analyst Intern" 
          class="w-full aspect-[4/5] object-cover object-center filter grayscale contrast-105 group-hover:grayscale-0 transition-all duration-700 ease-out"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#06152b]/65 via-transparent to-transparent pointer-events-none"></div>

        <!-- Floating badge on image -->
        <div class="absolute bottom-5 left-5 right-5 p-4 bg-white/95 border border-[#d5e7f5] flex items-center justify-between shadow-sm">
          <div class="flex flex-col">
            <span class="text-xs font-mono tracking-wider text-[#091e36] font-bold">ITBA CERTIFIED &amp; IELTS 7.5</span>
            <span class="text-xs text-[#5a7894] font-medium">UFLS - University of Danang (GPA 3.7/4)</span>
          </div>
          <div class="w-2 h-2 rounded-full bg-[#0ea5e9] animate-pulse"></div>
        </div>
      </div>

      <!-- Quick stats bar with crisp hairline boxes in Sky Blue tone -->
      <div class="grid grid-cols-3 gap-3 font-mono text-center">
        <div class="p-4 bg-white border border-[#d5e7f5] shadow-sm">
          <div class="text-xl sm:text-2xl font-bold text-[#091e36]">3.7<span class="text-xs text-[#5a7894] font-normal">/4.0</span></div>
          <div class="text-[10px] text-[#0284c7] uppercase mt-1 tracking-wider font-semibold">Final GPA</div>
        </div>
        <div class="p-4 bg-white border border-[#d5e7f5] shadow-sm">
          <div class="text-xl sm:text-2xl font-bold text-[#091e36]">7.5</div>
          <div class="text-[10px] text-[#0284c7] uppercase mt-1 tracking-wider font-semibold">IELTS Band</div>
        </div>
        <div class="p-4 bg-white border border-[#d5e7f5] shadow-sm">
          <div class="text-xl sm:text-2xl font-bold text-[#091e36]">ITBA</div>
          <div class="text-[10px] text-[#0284c7] uppercase mt-1 tracking-wider font-semibold">UDECAREER</div>
        </div>
      </div>
    </div>

    <!-- Right Column: Biography & Statement -->
    <div class="about-text-col lg:col-span-7 flex flex-col space-y-8">
      <!-- Big Statement with sky blue accents -->
      <div class="space-y-4">
        <h3 class="text-2xl sm:text-3xl md:text-4xl font-semibold tracking-tight text-[#091e36] leading-snug">
          I pair strong <span class="font-serif italic text-[#0284c7] text-3xl sm:text-4xl md:text-5xl font-normal">analytical rigor</span> with a focus on structured, user-centered <span class="font-serif italic text-[#0284c7] text-3xl sm:text-4xl md:text-5xl font-normal">systems</span>.
        </h3>
        <p class="text-base sm:text-lg text-[#2c4c6e] leading-relaxed">
          Graduated with distinction from <strong class="text-[#091e36]">The University of Danang - University of Foreign Language Studies</strong> (Final GPA: <strong class="text-[#0284c7]">3.7/4.0</strong>), backed by an <strong class="text-[#0284c7]">IELTS 7.5</strong> language proficiency and certified IT Business Analysis training from <strong class="text-[#091e36]">UDECAREER</strong>.
        </p>
      </div>

      <!-- Detailed paragraphs -->
      <div class="space-y-5 text-[#2c4c6e] leading-relaxed text-sm sm:text-base border-t border-[#d5e7f5] pt-8">
        <p>
          Trained in practical IT Business Analysis (<em>ITBA Thực Chiến: Cơ bản + Kỹ năng ITBA</em>), I possess hands-on capability in requirement elicitation, backlog management, drafting detailed User Stories with Acceptance Criteria, and mapping AS-IS vs. TO-BE business workflows with BPMN 2.0.
        </p>
        <p>
          Following modern BA standards, I leverage <strong class="text-[#091e36]">Mokkup.ai</strong> for rapid dashboard wireframing to clarify KPIs and reporting structures with stakeholders before writing SQL queries or building BI reports in Power BI and Tableau.
        </p>
        <p>
          With fluent bilingual communication (IELTS 7.5), a 3.7 GPA track record, and a structured problem-solving approach, I am seeking a <strong class="text-[#0284c7]">Business Analyst Intern</strong> role to bridge stakeholder vision with engineering execution.
        </p>
      </div>

      <!-- Action: Download CV / Contact in Sky Blue tone -->
      <div class="pt-4 flex flex-wrap items-center gap-4">
        <a 
          href="/assets/resume.pdf" 
          target="_blank"
          class="px-6 py-3.5 border border-[#0284c7] bg-[#0284c7] hover:bg-[#0369a1] text-white font-mono text-xs font-bold tracking-wider uppercase flex items-center gap-3 transition-all duration-300 shadow-sm"
          data-cursor="interactive"
        >
          <span>DOWNLOAD CV</span>
          <svg class="w-3.5 h-3.5 transform group-hover:translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
          </svg>
        </a>

        <a 
          href="#contact" 
          class="px-6 py-3.5 bg-white border border-[#d5e7f5] hover:border-[#0284c7] text-[#091e36] hover:text-[#0284c7] font-mono text-xs tracking-wider uppercase transition-colors shadow-sm"
          data-cursor="interactive"
        >
          GET IN TOUCH →
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener('DOMContentLoaded', () => {
    const mm = gsap.matchMedia();

    mm.add({
      isDesktop: '(min-width: 1024px)',
      isMobile: '(max-width: 1023px)',
    }, (context) => {
      const { isDesktop } = context.conditions;
      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: '#about',
          start: 'top 80%',
          toggleActions: 'play none none none',
          once: true,
        },
      });

      tl.from('.about-header', {
        y: 35,
        autoAlpha: 0,
        duration: 0.8,
        ease: 'power3.out',
        clearProps: 'all',
      })
      .from('.about-photo-col', {
        x: isDesktop ? -30 : 0,
        y: isDesktop ? 0 : 30,
        autoAlpha: 0,
        duration: 0.85,
        ease: 'power3.out',
        clearProps: 'all',
      }, '-=0.5')
      .from('.about-text-col', {
        x: isDesktop ? 30 : 0,
        y: isDesktop ? 0 : 30,
        autoAlpha: 0,
        duration: 0.85,
        ease: 'power3.out',
        clearProps: 'all',
      }, '-=0.65');
    });
  });
</script>
