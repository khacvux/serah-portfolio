---
interface SkillCategory {
  number: string;
  title: string;
  tagline: string;
  tools: string[];
  skills: string[];
}

const skillCategories: SkillCategory[] = [
  {
    number: '01',
    title: 'DASHBOARD WIREFRAMING & BI',
    tagline: 'Planning KPIs & reporting logic before BI engineering to eliminate costly rework.',
    tools: ['Mokkup.ai', 'Power BI (DAX)', 'Tableau', 'Figma'],
    skills: ['Dashboard Wireframing', 'KPI Hierarchy Design', 'Interactive Visualizations', 'BI Export to Power BI/Tableau', 'Self-Service Analytics'],
  },
  {
    number: '02',
    title: 'DATA QUERYING & MANAGEMENT',
    tagline: 'Extracting, transforming, and validating large datasets directly from production stores.',
    tools: ['SQL (Postgres, MySQL)', 'Advanced Excel', 'Python (Pandas)'],
    skills: ['Complex SQL Joins & Subqueries', 'Data Cleaning & Transformation', 'Pivot Tables & Power Query', 'Trend & Cohort Analysis', 'Variance & Anomaly Detection'],
  },
  {
    number: '03',
    title: 'REQUIREMENTS & AGILE DELIVERY',
    tagline: 'Bridging non-technical business stakeholders and engineering teams in Scrum sprints.',
    tools: ['Jira', 'Confluence', 'Miro', 'Notion'],
    skills: ['BRD & FRD Authoring', 'User Stories & Acceptance Criteria', 'MoSCoW Prioritization', 'Backlog Grooming & Sprints', 'Stakeholder Alignment'],
  },
  {
    number: '04',
    title: 'PROCESS MODELING & STRATEGY',
    tagline: 'Deconstructing business workflows to identify bottlenecks and automate handover delays.',
    tools: ['BPMN 2.0', 'Lucidchart', 'Visio', 'Draw.io'],
    skills: ['AS-IS vs. TO-BE Process Mapping', 'Root-Cause & Fishbone Analysis', 'Value Stream Mapping', 'Gap Analysis', 'Feasibility & ROI Studies'],
  },
];

const chartVisualizations = [
  { type: 'Bar Charts', desc: 'Categorical comparisons (Territory sales, product revenue)' },
  { type: 'Line Charts', desc: 'Time-series trend analysis (Monthly ARR, churn velocity)' },
  { type: 'Pie / Donut', desc: 'Composition & proportion of market share' },
  { type: 'Scatter Plots', desc: 'Correlation analysis (Ad spend vs. revenue conversion)' },
  { type: 'Histograms', desc: 'Distribution analytics (Customer age cohorts, ticket times)' },
];
---

<section id="skills" class="py-24 sm:py-32 px-6 lg:px-12 max-w-7xl mx-auto">
  <!-- Section Title Header -->
  <div class="skills-header border-b border-white/10 pb-8 mb-16 flex flex-col md:flex-row md:items-end justify-between gap-6">
    <div class="space-y-3">
      <div class="flex items-center gap-2 text-xs font-mono tracking-widest text-brand-neon uppercase">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-neon"></span>
        <span>&#123; 03 / BA TOOLKIT &amp; CAPABILITIES &#125;</span>
      </div>
      <h2 class="text-4xl sm:text-6xl font-bold tracking-tight text-white uppercase">
        TECHNICAL &amp; BUSINESS ARSENAL
      </h2>
    </div>
    <div class="text-xs font-mono text-zinc-400 max-w-md md:text-right">
      <span class="text-zinc-600">// STANDARDS</span> IIBA BABOK® ALIGNED · MODERN 2026 TOOLKIT
    </div>
  </div>

  <!-- 4-Column Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    {skillCategories.map((cat) => (
      <div class="skill-card group p-6 sm:p-8 rounded-2xl bg-dark-900 border border-white/5 hover:border-brand-500/40 transition-all duration-400 hover:bg-dark-850 flex flex-col justify-between space-y-6 hover:shadow-[0_0_25px_rgba(56,116,255,0.06)]">
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <span class="font-mono text-xs font-bold text-brand-neon px-2 py-0.5 rounded bg-brand-neon/10 border border-brand-neon/20">
              {cat.number}
            </span>
            <span class="w-2 h-2 rounded-full bg-zinc-700 group-hover:bg-brand-neon transition-colors"></span>
          </div>

          <h3 class="text-xl font-bold text-white group-hover:text-brand-neon transition-colors">
            {cat.title}
          </h3>

          <p class="text-xs text-zinc-400 leading-relaxed font-light">
            {cat.tagline}
          </p>

          <!-- Primary Tools -->
          <div class="flex flex-wrap gap-1.5 pt-2">
            {cat.tools.map((t) => (
              <span class="px-2 py-0.5 rounded bg-dark-950 border border-white/10 text-zinc-300 font-mono text-[10px]">
                {t}
              </span>
            ))}
          </div>
        </div>

        <div class="border-t border-white/5 pt-4 space-y-2">
          {cat.skills.map((skill) => (
            <div class="flex items-center gap-2 text-xs font-mono text-zinc-400 group-hover:text-zinc-300 transition-colors">
              <span class="text-brand-neon/60">→</span>
              <span>{skill}</span>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>

  <!-- Data Visualization Mastery Banner (Referencing Mokkup.ai Chart Guide) -->
  <div class="mt-12 p-6 sm:p-8 rounded-2xl bg-dark-900 border border-white/10 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6">
    <div class="space-y-1 max-w-md">
      <div class="text-xs font-mono text-brand-neon tracking-widest uppercase">
        DATA STORYTELLING // ESSENTIAL CHART MASTERY
      </div>
      <div class="text-sm text-zinc-300 font-medium">
        Selecting the right visual for the right business decision.
      </div>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 w-full lg:w-auto font-mono text-xs">
      {chartVisualizations.map((chart) => (
        <div class="p-3 rounded-xl bg-dark-950 border border-white/5 flex flex-col justify-between">
          <span class="text-brand-neon font-bold">{chart.type}</span>
          <span class="text-[10px] text-zinc-500 mt-1 line-clamp-2">{chart.desc}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener('DOMContentLoaded', () => {
    gsap.from('.skills-header', {
      scrollTrigger: {
        trigger: '.skills-header',
        start: 'top 85%',
        toggleActions: 'play none none none',
      },
      y: 40,
      opacity: 0,
      duration: 0.8,
      ease: 'power3.out',
    });

    ScrollTrigger.batch('.skill-card', {
      start: 'top 85%',
      onEnter: (batch) => {
        gsap.from(batch, {
          y: 40,
          opacity: 0,
          stagger: 0.1,
          duration: 0.8,
          ease: 'power3.out',
          overwrite: true,
        });
      },
      once: true,
    });
  });
</script>
