---
interface SkillCategory {
  number: string;
  title: string;
  tagline: string;
  tools: string[];
  skills: string[];
}

const skillCategories: SkillCategory[] = [
  {
    number: '01',
    title: 'DASHBOARD WIREFRAMING & BI',
    tagline: 'Planning KPIs & reporting logic before BI engineering to eliminate costly rework.',
    tools: ['Mokkup.ai', 'Power BI (DAX)', 'Tableau', 'Figma'],
    skills: ['Dashboard Wireframing', 'KPI Hierarchy Design', 'Interactive Visualizations', 'BI Export to Power BI/Tableau', 'Self-Service Analytics'],
  },
  {
    number: '02',
    title: 'DATA QUERYING & MANAGEMENT',
    tagline: 'Extracting, transforming, and validating large datasets directly from production stores.',
    tools: ['SQL (Postgres, MySQL)', 'Advanced Excel', 'Python (Pandas)'],
    skills: ['Complex SQL Joins & Subqueries', 'Data Cleaning & Transformation', 'Pivot Tables & Power Query', 'Trend & Cohort Analysis', 'Variance & Anomaly Detection'],
  },
  {
    number: '03',
    title: 'REQUIREMENTS & AGILE DELIVERY',
    tagline: 'Bridging non-technical business stakeholders and engineering teams in Scrum sprints.',
    tools: ['Jira', 'Confluence', 'Miro', 'Notion'],
    skills: ['BRD & FRD Authoring', 'User Stories & Acceptance Criteria', 'MoSCoW Prioritization', 'Backlog Grooming & Sprints', 'Stakeholder Alignment'],
  },
  {
    number: '04',
    title: 'PROCESS MODELING & STRATEGY',
    tagline: 'Deconstructing business workflows to identify bottlenecks and automate handover delays.',
    tools: ['BPMN 2.0', 'Lucidchart', 'Visio', 'Draw.io'],
    skills: ['AS-IS vs. TO-BE Process Mapping', 'Root-Cause & Fishbone Analysis', 'Value Stream Mapping', 'Gap Analysis', 'Feasibility & ROI Studies'],
  },
];

const chartVisualizations = [
  { type: 'Bar Charts', desc: 'Categorical comparisons (Territory sales, product revenue)' },
  { type: 'Line Charts', desc: 'Time-series trend analysis (Monthly ARR, churn velocity)' },
  { type: 'Pie / Donut', desc: 'Composition & proportion of market share' },
  { type: 'Scatter Plots', desc: 'Correlation analysis (Ad spend vs. revenue conversion)' },
  { type: 'Histograms', desc: 'Distribution analytics (Customer age cohorts, ticket times)' },
];
---

<section id="skills" class="py-24 sm:py-32 px-6 lg:px-12 max-w-7xl mx-auto">
  <!-- Section Title Header -->
  <div class="skills-header border-b border-slate-200 pb-8 mb-16 flex flex-col md:flex-row md:items-end justify-between gap-6">
    <div class="space-y-3">
      <div class="flex items-center gap-2 text-xs font-mono tracking-widest text-sky-600 font-bold uppercase">
        <span class="w-1.5 h-1.5 rounded-full bg-sky-500"></span>
        <span>&#123; 03 / BA TOOLKIT &amp; CAPABILITIES &#125;</span>
      </div>
      <h2 class="text-4xl sm:text-6xl font-bold tracking-tight text-ink-950 uppercase">
        TECHNICAL &amp; BUSINESS ARSENAL
      </h2>
    </div>
    <div class="text-xs font-mono text-ink-500 max-w-md md:text-right">
      <span class="text-ink-400">// STANDARDS</span> IIBA BABOK® ALIGNED · MODERN 2026 TOOLKIT
    </div>
  </div>

  <!-- 4-Column Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    {skillCategories.map((cat) => (
      <div class="skill-card group p-6 sm:p-8 rounded-2xl bg-white border border-slate-200/80 hover:border-sky-400 transition-colors duration-300 hover:shadow-[0_8px_30px_rgba(2,132,199,0.08)] flex flex-col justify-between space-y-6 shadow-sm">
        <div class="space-y-4">
          <div class="flex items-center justify-between">
            <span class="font-mono text-xs font-bold text-sky-700 px-2.5 py-0.5 rounded-full bg-sky-50 border border-sky-200">
              {cat.number}
            </span>
            <span class="w-2 h-2 rounded-full bg-slate-300 group-hover:bg-sky-500 transition-colors"></span>
          </div>

          <h3 class="text-xl font-bold text-ink-950 group-hover:text-sky-600 transition-colors">
            {cat.title}
          </h3>

          <p class="text-xs text-ink-600 leading-relaxed font-light">
            {cat.tagline}
          </p>

          <!-- Primary Tools -->
          <div class="flex flex-wrap gap-1.5 pt-2">
            {cat.tools.map((t) => (
              <span class="px-2.5 py-0.5 rounded-md bg-slate-50 border border-slate-200 text-ink-700 font-mono text-[10px] font-medium">
                {t}
              </span>
            ))}
          </div>
        </div>

        <div class="border-t border-slate-100 pt-4 space-y-2">
          {cat.skills.map((skill) => (
            <div class="flex items-center gap-2 text-xs font-mono text-ink-600 group-hover:text-ink-900 transition-colors">
              <span class="text-sky-600 font-bold">→</span>
              <span>{skill}</span>
            </div>
          ))}
        </div>
      </div>
    ))}
  </div>

  <!-- Data Visualization Mastery Banner (Referencing Mokkup.ai Chart Guide) -->
  <div class="mt-12 p-6 sm:p-8 rounded-2xl bg-sky-50/70 border border-sky-100 flex flex-col lg:flex-row items-start lg:items-center justify-between gap-6 shadow-sm">
    <div class="space-y-1 max-w-md">
      <div class="text-xs font-mono text-sky-700 font-bold tracking-widest uppercase">
        DATA STORYTELLING // ESSENTIAL CHART MASTERY
      </div>
      <div class="text-sm text-ink-800 font-medium">
        Selecting the right visual for the right business decision.
      </div>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3 w-full lg:w-auto font-mono text-xs">
      {chartVisualizations.map((chart) => (
        <div class="p-3.5 rounded-xl bg-white border border-slate-200 shadow-sm flex flex-col justify-between">
          <span class="text-sky-700 font-bold">{chart.type}</span>
          <span class="text-[10px] text-ink-500 mt-1 line-clamp-2">{chart.desc}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener('DOMContentLoaded', () => {
    gsap.from('.skills-header', {
      scrollTrigger: {
        trigger: '.skills-header',
        start: 'top 85%',
        toggleActions: 'play none none none',
        once: true,
      },
      y: 35,
      autoAlpha: 0,
      duration: 0.8,
      ease: 'power3.out',
      clearProps: 'transform,opacity,visibility',
    });

    ScrollTrigger.batch('.skill-card', {
      start: 'top 85%',
      onEnter: (batch) => {
        gsap.from(batch, {
          y: 35,
          autoAlpha: 0,
          stagger: 0.1,
          duration: 0.8,
          ease: 'power3.out',
          clearProps: 'transform,opacity,visibility',
          overwrite: 'auto',
        });
      },
      once: true,
    });
  });
</script>
