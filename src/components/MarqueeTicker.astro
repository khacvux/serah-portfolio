---
<div class="relative w-full py-8 border-y border-white/10 bg-dark-900/40 overflow-hidden select-none my-12">
  <div id="ticker-track" class="flex whitespace-nowrap will-change-transform">
    <!-- Duplicate items to create infinite loop -->
    <div class="ticker-content flex items-center gap-10 font-mono text-xs sm:text-sm font-semibold tracking-widest text-zinc-400 uppercase">
      <span class="flex items-center gap-3">
        <span class="text-brand-neon">✦</span>
        <span class="hover:text-white transition-colors">CREATIVE DIRECTION</span>
      </span>
      <span class="flex items-center gap-3">
        <span class="text-brand-neon">✦</span>
        <span class="hover:text-white transition-colors">EXPERIENCE DESIGN</span>
      </span>
      <span class="flex items-center gap-3">
        <span class="text-brand-neon">✦</span>
        <span class="hover:text-white transition-colors">GSAP MOTION &amp; MICRO-INTERACTIONS</span>
      </span>
      <span class="flex items-center gap-3">
        <span class="text-brand-neon">✦</span>
        <span class="hover:text-white transition-colors">DESIGN SYSTEMS</span>
      </span>
      <span class="flex items-center gap-3">
        <span class="text-brand-neon">✦</span>
        <span class="hover:text-white transition-colors">ASTRO ARCHITECTURE</span>
      </span>
      <span class="flex items-center gap-3">
        <span class="text-brand-neon">✦</span>
        <span class="hover:text-white transition-colors">HIGH-CONVERSION PROTOTYPES</span>
      </span>
      <span class="flex items-center gap-3">
        <span class="text-brand-neon">✦</span>
        <span class="hover:text-white transition-colors">FULL-STACK EXECUTION</span>
      </span>
    </div>

    <!-- Duplicate for seamless wrap -->
    <div class="ticker-content flex items-center gap-10 font-mono text-xs sm:text-sm font-semibold tracking-widest text-zinc-400 uppercase ml-10">
      <span class="flex items-center gap-3">
        <span class="text-brand-neon">✦</span>
        <span class="hover:text-white transition-colors">CREATIVE DIRECTION</span>
      </span>
      <span class="flex items-center gap-3">
        <span class="text-brand-neon">✦</span>
        <span class="hover:text-white transition-colors">EXPERIENCE DESIGN</span>
      </span>
      <span class="flex items-center gap-3">
        <span class="text-brand-neon">✦</span>
        <span class="hover:text-white transition-colors">GSAP MOTION &amp; MICRO-INTERACTIONS</span>
      </span>
      <span class="flex items-center gap-3">
        <span class="text-brand-neon">✦</span>
        <span class="hover:text-white transition-colors">DESIGN SYSTEMS</span>
      </span>
      <span class="flex items-center gap-3">
        <span class="text-brand-neon">✦</span>
        <span class="hover:text-white transition-colors">ASTRO ARCHITECTURE</span>
      </span>
      <span class="flex items-center gap-3">
        <span class="text-brand-neon">✦</span>
        <span class="hover:text-white transition-colors">HIGH-CONVERSION PROTOTYPES</span>
      </span>
      <span class="flex items-center gap-3">
        <span class="text-brand-neon">✦</span>
        <span class="hover:text-white transition-colors">FULL-STACK EXECUTION</span>
      </span>
    </div>
  </div>
</div>

<script>
  import gsap from 'gsap';

  window.addEventListener('DOMContentLoaded', () => {
    const track = document.getElementById('ticker-track');
    if (!track) return;

    // Use GSAP timeline for silky smooth marquee
    gsap.to(track, {
      xPercent: -50,
      ease: 'none',
      duration: 25,
      repeat: -1,
    });
  });
</script>
