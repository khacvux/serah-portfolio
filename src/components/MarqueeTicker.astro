---
---
<div class="relative w-full py-8 border-y border-white/10 bg-dark-900/40 overflow-hidden select-none my-12">
  <div id="ticker-track" class="flex whitespace-nowrap will-change-transform">
    <!-- Duplicate items to create infinite loop -->
    <div class="ticker-content flex items-center gap-10 font-mono text-xs sm:text-sm font-semibold tracking-widest text-zinc-400 uppercase">
      <span class="flex items-center gap-3">
        <span class="text-brand-neon">✦</span>
        <span class="hover:text-white transition-colors">REQUIREMENTS GATHERING (BRD/FRD)</span>
      </span>
      <span class="flex items-center gap-3">
        <span class="text-brand-neon">✦</span>
        <span class="hover:text-white transition-colors">DASHBOARD WIREFRAMING (MOKKUP.AI)</span>
      </span>
      <span class="flex items-center gap-3">
        <span class="text-brand-neon">✦</span>
        <span class="hover:text-white transition-colors">SQL QUERYING &amp; DATA MODELING</span>
      </span>
      <span class="flex items-center gap-3">
        <span class="text-brand-neon">✦</span>
        <span class="hover:text-white transition-colors">POWER BI &amp; TABLEAU VISUALIZATION</span>
      </span>
      <span class="flex items-center gap-3">
        <span class="text-brand-neon">✦</span>
        <span class="hover:text-white transition-colors">PROCESS MAPPING (BPMN 2.0)</span>
      </span>
      <span class="flex items-center gap-3">
        <span class="text-brand-neon">✦</span>
        <span class="hover:text-white transition-colors">AGILE / SCRUM SPRINT DELIVERY</span>
      </span>
      <span class="flex items-center gap-3">
        <span class="text-brand-neon">✦</span>
        <span class="hover:text-white transition-colors">STAKEHOLDER COMMUNICATION</span>
      </span>
    </div>

    <!-- Duplicate for seamless wrap -->
    <div class="ticker-content flex items-center gap-10 font-mono text-xs sm:text-sm font-semibold tracking-widest text-zinc-400 uppercase ml-10">
      <span class="flex items-center gap-3">
        <span class="text-brand-neon">✦</span>
        <span class="hover:text-white transition-colors">REQUIREMENTS GATHERING (BRD/FRD)</span>
      </span>
      <span class="flex items-center gap-3">
        <span class="text-brand-neon">✦</span>
        <span class="hover:text-white transition-colors">DASHBOARD WIREFRAMING (MOKKUP.AI)</span>
      </span>
      <span class="flex items-center gap-3">
        <span class="text-brand-neon">✦</span>
        <span class="hover:text-white transition-colors">SQL QUERYING &amp; DATA MODELING</span>
      </span>
      <span class="flex items-center gap-3">
        <span class="text-brand-neon">✦</span>
        <span class="hover:text-white transition-colors">POWER BI &amp; TABLEAU VISUALIZATION</span>
      </span>
      <span class="flex items-center gap-3">
        <span class="text-brand-neon">✦</span>
        <span class="hover:text-white transition-colors">PROCESS MAPPING (BPMN 2.0)</span>
      </span>
      <span class="flex items-center gap-3">
        <span class="text-brand-neon">✦</span>
        <span class="hover:text-white transition-colors">AGILE / SCRUM SPRINT DELIVERY</span>
      </span>
      <span class="flex items-center gap-3">
        <span class="text-brand-neon">✦</span>
        <span class="hover:text-white transition-colors">STAKEHOLDER COMMUNICATION</span>
      </span>
    </div>
  </div>
</div>

<script>
  import gsap from 'gsap';

  window.addEventListener('DOMContentLoaded', () => {
    const track = document.getElementById('ticker-track');
    if (!track) return;

    gsap.to(track, {
      xPercent: -50,
      ease: 'none',
      duration: 25,
      repeat: -1,
    });
  });
</script>
