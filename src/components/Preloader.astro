---
---
<div id="preloader" class="fixed inset-0 z-[10000] flex flex-col justify-between bg-white p-6 sm:p-12 text-ink-900 select-none overflow-hidden border-b border-slate-200">
  <!-- Top bar -->
  <div class="flex items-center justify-between text-xs tracking-widest font-mono text-ink-500">
    <div class="flex items-center gap-2">
      <span class="inline-block w-2 h-2 rounded-full bg-brand-500 animate-ping"></span>
      <span class="text-ink-900 font-bold">DIỆU THẢO // BUSINESS ANALYST</span>
    </div>
    <div class="hidden sm:block text-brand-600 font-semibold">
      &#123; SYSTEM INITIALIZING &#125;
    </div>
    <div class="text-ink-400">
      PORTFOLIO 2026
    </div>
  </div>

  <!-- Center animated status -->
  <div class="my-auto text-center flex flex-col items-center justify-center space-y-4">
    <div class="text-xs font-mono tracking-widest text-brand-600 font-bold uppercase">
      &#123; LOADING BA CASE STUDIES &#125;
    </div>
    <div class="text-7xl sm:text-9xl md:text-[11rem] font-mono font-bold tracking-tighter text-ink-950 tabular-nums flex items-baseline justify-center">
      <span id="loader-number">00</span>
      <span class="text-3xl sm:text-5xl text-brand-500 font-sans ml-1">%</span>
    </div>
    <div class="w-48 sm:w-64 h-[3px] bg-slate-100 rounded-full overflow-hidden mt-6">
      <div id="loader-bar" class="h-full bg-gradient-to-r from-sky-400 via-blue-500 to-indigo-500 w-0"></div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="flex items-center justify-between text-xs font-mono text-ink-400 border-t border-slate-100 pt-4">
    <span>REQUIREMENTS &amp; DATA</span>
    <span>BUSINESS LOGIC &amp; STRATEGY</span>
    <span>[ 60 FPS MOTION ]</span>
  </div>
</div>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener('DOMContentLoaded', () => {
    const preloader = document.getElementById('preloader');
    const loaderNum = document.getElementById('loader-number');
    const loaderBar = document.getElementById('loader-bar');
    
    if (!preloader || !loaderNum || !loaderBar) return;

    // Check if user already saw preloader in this session
    if (sessionStorage.getItem('dieuthao_loaded')) {
      preloader.style.display = 'none';
      window.dispatchEvent(new CustomEvent('preloaderDone'));
      setTimeout(() => ScrollTrigger.refresh(), 50);
      return;
    }

    // Disable scrolling while preloader is active to protect ScrollTrigger coordinates
    document.body.style.overflow = 'hidden';

    const countObj = { val: 0 };
    const tl = gsap.timeline({
      onComplete: () => {
        sessionStorage.setItem('dieuthao_loaded', 'true');
        document.body.style.overflow = '';
        ScrollTrigger.refresh();
      }
    });

    tl.to(countObj, {
      val: 100,
      duration: 1.5,
      ease: 'power2.inOut',
      onUpdate: () => {
        const rounded = Math.round(countObj.val);
        loaderNum.textContent = rounded < 10 ? `0${rounded}` : `${rounded}`;
        loaderBar.style.width = `${rounded}%`;
      }
    })
    .to(preloader, {
      yPercent: -100,
      duration: 0.85,
      ease: 'power4.inOut',
      delay: 0.05,
      onStart: () => {
        // Trigger hero entrance synchronously as the preloader curtain rises
        window.dispatchEvent(new CustomEvent('preloaderDone'));
      }
    })
    .set(preloader, {
      display: 'none'
    });
  });
</script>
