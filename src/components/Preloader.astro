---
---
<div id="preloader" class="fixed inset-0 z-[10000] flex flex-col justify-between bg-dark-950 p-6 sm:p-12 text-zinc-100 select-none overflow-hidden">
  <!-- Top bar -->
  <div class="flex items-center justify-between text-xs tracking-widest font-mono text-zinc-400">
    <div class="flex items-center gap-2">
      <span class="inline-block w-2 h-2 rounded-full bg-brand-neon animate-ping"></span>
      <span class="text-zinc-200">DIỆU THẢO // BUSINESS ANALYST</span>
    </div>
    <div class="hidden sm:block text-brand-neon">
      &#123; SYSTEM INITIALIZING &#125;
    </div>
    <div class="text-zinc-400">
      PORTFOLIO 2026
    </div>
  </div>

  <!-- Center animated status -->
  <div class="my-auto text-center flex flex-col items-center justify-center space-y-4">
    <div class="text-xs font-mono tracking-widest text-brand-neon uppercase">
      &#123; LOADING BA CASE STUDIES &#125;
    </div>
    <div class="text-7xl sm:text-9xl md:text-[11rem] font-mono font-bold tracking-tighter text-white tabular-nums flex items-baseline justify-center">
      <span id="loader-number">00</span>
      <span class="text-3xl sm:text-5xl text-brand-500 font-sans ml-1">%</span>
    </div>
    <div class="w-48 sm:w-64 h-[2px] bg-zinc-800 rounded-full overflow-hidden mt-6">
      <div id="loader-bar" class="h-full bg-gradient-to-r from-brand-600 via-brand-500 to-brand-neon w-0"></div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="flex items-center justify-between text-xs font-mono text-zinc-500 border-t border-zinc-900 pt-4">
    <span>REQUIREMENTS &amp; DATA</span>
    <span>BUSINESS LOGIC &amp; STRATEGY</span>
    <span>[ 60 FPS MOTION ]</span>
  </div>
</div>

<script>
  import gsap from 'gsap';

  window.addEventListener('DOMContentLoaded', () => {
    const preloader = document.getElementById('preloader');
    const loaderNum = document.getElementById('loader-number');
    const loaderBar = document.getElementById('loader-bar');
    
    if (!preloader || !loaderNum || !loaderBar) return;

    const countObj = { val: 0 };
    const tl = gsap.timeline({
      onComplete: () => {
        sessionStorage.setItem('dieuthao_loaded', 'true');
        window.dispatchEvent(new CustomEvent('preloaderDone'));
      }
    });

    tl.to(countObj, {
      val: 100,
      duration: 1.6,
      ease: 'power2.inOut',
      onUpdate: () => {
        const rounded = Math.round(countObj.val);
        loaderNum.textContent = rounded < 10 ? `0${rounded}` : `${rounded}`;
        loaderBar.style.width = `${rounded}%`;
      }
    })
    .to(preloader, {
      yPercent: -100,
      duration: 0.9,
      ease: 'power4.inOut',
      delay: 0.1
    })
    .set(preloader, {
      display: 'none'
    });
  });
</script>
