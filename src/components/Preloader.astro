---
---
<div id="preloader" class="fixed inset-0 z-[10000] flex flex-col justify-between bg-[#f0f7fc] p-6 sm:p-12 text-[#091e36] select-none overflow-hidden border-b border-[#d5e7f5]">
  <!-- Top bar -->
  <div class="flex items-center justify-between text-xs tracking-widest font-mono text-[#5a7894]">
    <div class="flex items-center gap-2">
      <span class="inline-block w-1.5 h-1.5 rounded-full bg-[#0ea5e9] animate-pulse"></span>
      <span class="text-[#091e36] font-semibold">DIỆU THẢO // PORTFOLIO</span>
    </div>
    <div class="hidden sm:block text-[#5a7894]">
      &#123; LOADING &#125;
    </div>
    <div class="text-[#5a7894]">
      [ 2026 ]
    </div>
  </div>

  <!-- Center animated status -->
  <div class="my-auto text-center flex flex-col items-center justify-center space-y-4">
    <div class="text-xs font-mono tracking-widest text-[#5a7894] uppercase">
      &#123; SYSTEM INITIALIZING &#125;
    </div>
    <div class="text-7xl sm:text-9xl md:text-[11rem] font-mono font-bold tracking-tighter text-[#091e36] tabular-nums flex items-baseline justify-center">
      <span id="loader-number">00</span>
      <span class="text-3xl sm:text-5xl text-[#5a7894] font-sans ml-1">%</span>
    </div>
    <div class="w-48 sm:w-64 h-[2px] bg-[#d5e7f5] rounded-none overflow-hidden mt-6">
      <div id="loader-bar" class="h-full bg-[#0284c7] w-full scale-x-0 origin-left transform-gpu"></div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="flex items-center justify-between text-xs font-mono text-[#5a7894] border-t border-[#d5e7f5] pt-4">
    <span>BUSINESS LOGIC</span>
    <span class="hidden sm:inline">DATA INSIGHTS &amp; STRATEGY</span>
    <span>[ 60 FPS MOTION ]</span>
  </div>
</div>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener('DOMContentLoaded', () => {
    const preloader = document.getElementById('preloader');
    const loaderNum = document.getElementById('loader-number');
    const loaderBar = document.getElementById('loader-bar');
    
    if (!preloader || !loaderNum || !loaderBar) return;

    // Check if user already saw preloader in this session
    if (sessionStorage.getItem('dieuthao_loaded')) {
      preloader.style.display = 'none';
      window.dispatchEvent(new CustomEvent('preloaderDone'));
      setTimeout(() => ScrollTrigger.refresh(), 50);
      return;
    }

    // Disable scrolling while preloader is active to protect ScrollTrigger coordinates
    document.body.style.overflow = 'hidden';

    const countObj = { val: 0 };
    const tl = gsap.timeline({
      onComplete: () => {
        sessionStorage.setItem('dieuthao_loaded', 'true');
        document.body.style.overflow = '';
        ScrollTrigger.refresh();
      }
    });

    tl.to(countObj, {
      val: 100,
      duration: 1.4,
      ease: 'power2.inOut',
      onUpdate: () => {
        const rounded = Math.round(countObj.val);
        loaderNum.textContent = rounded < 10 ? `0${rounded}` : `${rounded}`;
      }
    })
    .to(loaderBar, {
      scaleX: 1,
      duration: 1.4,
      ease: 'power2.inOut',
    }, 0)
    .to(preloader, {
      yPercent: -100,
      duration: 0.95,
      ease: 'expo.inOut',
      delay: 0.05,
      onStart: () => {
        window.dispatchEvent(new CustomEvent('preloaderDone'));
      }
    })
    .set(preloader, {
      display: 'none'
    });
  });
</script>
