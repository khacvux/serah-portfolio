---
<header id="site-header" class="fixed top-0 left-0 w-full z-50 bg-white/85 backdrop-blur-md border-b border-slate-200/80 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-6 lg:px-12 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="#home" class="group flex items-center gap-3 text-ink-900 transition-opacity hover:opacity-80">
      <div class="w-8 h-8 rounded-full bg-sky-50 border border-sky-200 flex items-center justify-center text-sky-600 font-mono font-bold text-xs tracking-wider group-hover:scale-105 transition-transform shadow-sm">
        DT
      </div>
      <div class="flex flex-col">
        <span class="text-sm font-bold tracking-tight text-ink-950 flex items-center gap-1.5">
          DIỆU THẢO
          <span class="inline-block w-1.5 h-1.5 rounded-full bg-brand-500 shadow-[0_0_8px_#38bdf8]"></span>
        </span>
        <span class="text-[10px] font-mono tracking-widest text-ink-500 uppercase">BUSINESS ANALYST INTERN</span>
      </div>
    </a>

    <!-- Center / Status Badge -->
    <div class="hidden md:flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-sky-50 border border-sky-200/70 text-[11px] font-mono text-sky-800">
      <span class="relative flex h-2 w-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-sky-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full h-2 w-2 bg-sky-500"></span>
      </span>
      <span class="text-sky-900 font-medium">SEEKING BA INTERNSHIP ROLES</span>
    </div>

    <!-- Navigation Links -->
    <nav class="hidden lg:flex items-center gap-8 text-xs font-mono">
      <a href="#projects" class="group flex items-center gap-1.5 text-ink-600 hover:text-sky-600 transition-colors">
        <span class="text-sky-600 font-bold group-hover:text-sky-700 transition-colors">01</span>
        <span>PROJECTS</span>
      </a>
      <a href="#about" class="group flex items-center gap-1.5 text-ink-600 hover:text-sky-600 transition-colors">
        <span class="text-sky-600 font-bold group-hover:text-sky-700 transition-colors">02</span>
        <span>ABOUT</span>
      </a>
      <a href="#skills" class="group flex items-center gap-1.5 text-ink-600 hover:text-sky-600 transition-colors">
        <span class="text-sky-600 font-bold group-hover:text-sky-700 transition-colors">03</span>
        <span>TOOLKIT</span>
      </a>
      <a href="#experience" class="group flex items-center gap-1.5 text-ink-600 hover:text-sky-600 transition-colors">
        <span class="text-sky-600 font-bold group-hover:text-sky-700 transition-colors">04</span>
        <span>EDUCATION &amp; EXP</span>
      </a>
      <a href="#contact" class="group flex items-center gap-1.5 text-ink-600 hover:text-sky-600 transition-colors">
        <span class="text-sky-600 font-bold group-hover:text-sky-700 transition-colors">05</span>
        <span>CONTACT</span>
      </a>

      <!-- CTA Button -->
      <a 
        href="#contact" 
        class="ml-4 px-4 py-2 rounded-full border border-sky-600/30 bg-sky-50 hover:bg-sky-600 hover:text-white text-sky-700 font-mono font-semibold transition-all duration-300 shadow-sm hover:shadow-[0_4px_14px_rgba(2,132,199,0.25)]"
      >
        HIRE ME
      </a>
    </nav>

    <!-- Mobile Hamburger Toggle -->
    <button id="mobile-toggle" aria-label="Toggle Navigation Menu" class="lg:hidden p-2 text-ink-600 hover:text-ink-950 focus:outline-none">
      <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16m-7 6h7"></path>
      </svg>
      <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-drawer" class="fixed inset-x-0 top-20 bg-white/95 border-b border-slate-200 backdrop-blur-xl px-8 py-10 hidden flex-col space-y-6 lg:hidden shadow-xl">
    <div class="flex flex-col space-y-5 font-mono text-base">
      <a href="#projects" class="mobile-nav-link text-ink-800 hover:text-sky-600 flex items-center justify-between border-b border-slate-100 pb-3">
        <span>PROJECTS</span>
        <span class="text-sky-600 text-xs font-bold">01</span>
      </a>
      <a href="#about" class="mobile-nav-link text-ink-800 hover:text-sky-600 flex items-center justify-between border-b border-slate-100 pb-3">
        <span>ABOUT</span>
        <span class="text-sky-600 text-xs font-bold">02</span>
      </a>
      <a href="#skills" class="mobile-nav-link text-ink-800 hover:text-sky-600 flex items-center justify-between border-b border-slate-100 pb-3">
        <span>TOOLKIT</span>
        <span class="text-sky-600 text-xs font-bold">03</span>
      </a>
      <a href="#experience" class="mobile-nav-link text-ink-800 hover:text-sky-600 flex items-center justify-between border-b border-slate-100 pb-3">
        <span>EDUCATION &amp; EXP</span>
        <span class="text-sky-600 text-xs font-bold">04</span>
      </a>
      <a href="#contact" class="mobile-nav-link text-ink-800 hover:text-sky-600 flex items-center justify-between border-b border-slate-100 pb-3">
        <span>CONTACT</span>
        <span class="text-sky-600 text-xs font-bold">05</span>
      </a>
    </div>

    <div class="pt-4 flex items-center justify-between text-xs font-mono text-ink-500">
      <div class="flex items-center gap-2">
        <span class="w-2 h-2 rounded-full bg-sky-500"></span>
        <span>OPEN FOR INTERNSHIPS</span>
      </div>
      <a href="mailto:dieuthao.tpqn@gmail.com" class="text-sky-600 font-bold hover:underline">dieuthao.tpqn@gmail.com</a>
    </div>
  </div>
</header>

<script>
  import gsap from 'gsap';

  window.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('mobile-toggle');
    const drawer = document.getElementById('mobile-drawer');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');
    const mobileLinks = document.querySelectorAll('.mobile-nav-link');

    let isOpen = false;

    function toggleMenu() {
      isOpen = !isOpen;
      if (isOpen) {
        drawer?.classList.remove('hidden');
        drawer?.classList.add('flex');
        hamburgerIcon?.classList.add('hidden');
        closeIcon?.classList.remove('hidden');
        gsap.from('#mobile-drawer .mobile-nav-link', {
          y: 20,
          autoAlpha: 0,
          stagger: 0.08,
          duration: 0.35,
          ease: 'power2.out',
          clearProps: 'transform,opacity,visibility',
        });
      } else {
        drawer?.classList.add('hidden');
        drawer?.classList.remove('flex');
        hamburgerIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
      }
    }

    toggleBtn?.addEventListener('click', toggleMenu);
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        if (isOpen) toggleMenu();
      });
    });
  });
</script>
