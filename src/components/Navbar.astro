---
---
<header id="site-header" class="fixed top-0 left-0 w-full z-50 bg-[#f0f7fc]/90 backdrop-blur-md border-b border-[#d5e7f5] transition-all duration-300">
  <div class="max-w-[1440px] mx-auto px-6 lg:px-12 h-20 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href="#home" class="group flex items-center gap-3 text-[#091e36] transition-opacity hover:opacity-85">
      <div class="flex flex-col">
        <span class="text-base font-semibold tracking-tight leading-none text-[#091e36]">
          Diệu Thảo
        </span>
        <span class="text-[11px] font-mono tracking-widest text-[#5a7894] uppercase mt-1">
          Business &amp; Data Analyst
        </span>
      </div>
    </a>

    <!-- Center / Status Badge -->
    <div class="hidden md:flex items-center gap-2 px-3.5 py-1.5 border border-[#d5e7f5] bg-white text-[11px] font-mono text-[#091e36] shadow-sm">
      <span class="w-1.5 h-1.5 rounded-full bg-[#0ea5e9] animate-pulse"></span>
      <span class="tracking-wider uppercase font-medium text-[#1e3852]">&#123; OPEN FOR OPPORTUNITIES · 2026 &#125;</span>
    </div>

    <!-- Navigation Links -->
    <nav class="hidden lg:flex items-center gap-8 text-xs font-mono">
      <a href="#projects" class="group flex items-center gap-2 text-[#5a7894] hover:text-[#091e36] transition-colors">
        <span class="text-[#0284c7] font-bold">01</span>
        <span class="tracking-wider">PROJECTS</span>
      </a>
      <a href="#about" class="group flex items-center gap-2 text-[#5a7894] hover:text-[#091e36] transition-colors">
        <span class="text-[#0284c7] font-bold">02</span>
        <span class="tracking-wider">ABOUT</span>
      </a>
      <a href="#skills" class="group flex items-center gap-2 text-[#5a7894] hover:text-[#091e36] transition-colors">
        <span class="text-[#0284c7] font-bold">03</span>
        <span class="tracking-wider">TOOLKIT</span>
      </a>
      <a href="#experience" class="group flex items-center gap-2 text-[#5a7894] hover:text-[#091e36] transition-colors">
        <span class="text-[#0284c7] font-bold">04</span>
        <span class="tracking-wider">CREDENTIALS</span>
      </a>
      <a href="#contact" class="group flex items-center gap-2 text-[#5a7894] hover:text-[#091e36] transition-colors">
        <span class="text-[#0284c7] font-bold">05</span>
        <span class="tracking-wider">CONTACT</span>
      </a>

      <!-- Social / Action -->
      <a 
        href="#contact" 
        class="ml-2 px-4 py-2 border border-[#0284c7] bg-[#0284c7] hover:bg-[#0369a1] text-white font-mono text-xs font-semibold tracking-wider transition-all duration-300 shadow-sm"
      >
        LET'S TALK
      </a>
    </nav>

    <!-- Mobile Hamburger Toggle -->
    <button id="mobile-toggle" aria-label="Toggle Navigation Menu" class="lg:hidden p-2 text-[#091e36] focus:outline-none">
      <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16m-7 6h7"></path>
      </svg>
      <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M6 18L18 6M6 6l12 12"></path>
      </svg>
    </button>
  </div>

  <!-- Mobile Drawer -->
  <div id="mobile-drawer" class="fixed inset-x-0 top-20 bg-[#f0f7fc] border-b border-[#d5e7f5] px-8 py-10 hidden flex-col space-y-6 lg:hidden shadow-xl">
    <div class="flex flex-col space-y-5 font-mono text-base">
      <a href="#projects" class="mobile-nav-link text-[#091e36] hover:text-[#0284c7] flex items-center justify-between border-b border-[#d5e7f5] pb-3">
        <span>PROJECTS</span>
        <span class="text-[#0284c7] text-xs font-bold">01</span>
      </a>
      <a href="#about" class="mobile-nav-link text-[#091e36] hover:text-[#0284c7] flex items-center justify-between border-b border-[#d5e7f5] pb-3">
        <span>ABOUT</span>
        <span class="text-[#0284c7] text-xs font-bold">02</span>
      </a>
      <a href="#skills" class="mobile-nav-link text-[#091e36] hover:text-[#0284c7] flex items-center justify-between border-b border-[#d5e7f5] pb-3">
        <span>TOOLKIT</span>
        <span class="text-[#0284c7] text-xs font-bold">03</span>
      </a>
      <a href="#experience" class="mobile-nav-link text-[#091e36] hover:text-[#0284c7] flex items-center justify-between border-b border-[#d5e7f5] pb-3">
        <span>CREDENTIALS</span>
        <span class="text-[#0284c7] text-xs font-bold">04</span>
      </a>
      <a href="#contact" class="mobile-nav-link text-[#091e36] hover:text-[#0284c7] flex items-center justify-between border-b border-[#d5e7f5] pb-3">
        <span>CONTACT</span>
        <span class="text-[#0284c7] text-xs font-bold">05</span>
      </a>
    </div>

    <div class="pt-4 flex items-center justify-between text-xs font-mono text-[#5a7894]">
      <div class="flex items-center gap-2">
        <span class="w-1.5 h-1.5 rounded-full bg-[#0ea5e9]"></span>
        <span>OPEN FOR INTERNSHIPS</span>
      </div>
      <a href="mailto:dieuthao.tpqn@gmail.com" class="text-[#0284c7] font-bold hover:underline">dieuthao.tpqn@gmail.com</a>
    </div>
  </div>
</header>

<script>
  import gsap from 'gsap';

  window.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('mobile-toggle');
    const drawer = document.getElementById('mobile-drawer');
    const hamburgerIcon = document.getElementById('hamburger-icon');
    const closeIcon = document.getElementById('close-icon');
    const mobileLinks = document.querySelectorAll('.mobile-nav-link');

    let isOpen = false;

    function toggleMenu() {
      isOpen = !isOpen;
      if (isOpen) {
        drawer?.classList.remove('hidden');
        drawer?.classList.add('flex');
        hamburgerIcon?.classList.add('hidden');
        closeIcon?.classList.remove('hidden');
        gsap.from('#mobile-drawer .mobile-nav-link', {
          y: 20,
          autoAlpha: 0,
          stagger: 0.08,
          duration: 0.35,
          ease: 'power2.out',
          clearProps: 'transform,opacity,visibility',
        });
      } else {
        drawer?.classList.add('hidden');
        drawer?.classList.remove('flex');
        hamburgerIcon?.classList.remove('hidden');
        closeIcon?.classList.add('hidden');
      }
    }

    toggleBtn?.addEventListener('click', toggleMenu);
    mobileLinks.forEach(link => {
      link.addEventListener('click', () => {
        if (isOpen) toggleMenu();
      });
    });
  });
</script>
