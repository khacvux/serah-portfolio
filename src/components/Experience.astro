---
interface ExperienceItem {
  role: string;
  organization: string;
  year: string;
  type: string;
  description: string;
  badge?: string;
  highlight?: boolean;
}

const timeline: ExperienceItem[] = [
  {
    role: 'Business Analysis (ITBA) Thực Chiến: Cơ bản + Kỹ năng ITBA',
    organization: 'UDECAREER',
    year: '2026',
    type: 'PROFESSIONAL CERTIFICATION',
    badge: 'ITBA CERTIFIED',
    description: 'Comprehensive practical training in IT Business Analysis: requirement elicitation, writing User Stories with Acceptance Criteria, drafting BRD & FRD specifications, process mapping (BPMN), backlog grooming, and Agile/Scrum ceremonies.',
    highlight: true,
  },
  {
    role: 'English Proficiency: IELTS 7.5',
    organization: 'International English Language Testing System',
    year: 'July 2026',
    type: 'LANGUAGE CERTIFICATION',
    badge: 'C1 ADVANCED',
    description: 'Fluent professional English proficiency for cross-border collaboration, client requirement discovery calls, executive presentations, and technical documentation.',
    highlight: true,
  },
  {
    role: 'Bachelor of Arts (BA) — Oriental Studies',
    organization: 'The University of Danang - University of Foreign Language Studies',
    year: 'Aug 2019 — Aug 2023',
    type: 'DEGREE (FINAL GPA: 3.7 / 4.0)',
    badge: 'GPA 3.7 / 4.0',
    description: 'Major in Oriental Studies. Developed advanced research methodologies, structured analytical thinking, cross-cultural communication, and qualitative data synthesis. Graduated with high academic distinction.',
  },
  {
    role: 'Business Analysis Case Study Capstone',
    organization: 'Enterprise E-Commerce Simulation',
    year: '2024 — 2025',
    type: 'PRACTICAL PROJECT',
    description: 'Conducted end-to-end business analysis for a retail platform; wireframed dashboard prototypes in Mokkup.ai, structured SQL aggregations, and authored comprehensive requirements documentation (BRD).',
  },
  {
    role: 'Project Coordination & Research Assistant',
    organization: 'University Academic Initiatives',
    year: '2021 — 2023',
    type: 'LEADERSHIP & ACADEMIC',
    description: 'Managed schedules, stakeholder correspondence, and research documentation for academic symposiums; synthesized multi-source data into executive presentation summaries.',
  },
];
---

<section id="experience" class="py-24 sm:py-32 px-6 lg:px-12 max-w-7xl mx-auto">
  <!-- Section Title Header -->
  <div class="experience-header border-b border-white/10 pb-8 mb-16 flex flex-col md:flex-row md:items-end justify-between gap-6">
    <div class="space-y-3">
      <div class="flex items-center gap-2 text-xs font-mono tracking-widest text-brand-neon uppercase">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-neon"></span>
        <span>&#123; 04 / EDUCATION &amp; CERTIFICATIONS &#125;</span>
      </div>
      <h2 class="text-4xl sm:text-6xl font-bold tracking-tight text-white uppercase">
        EDUCATION &amp; CREDENTIALS
      </h2>
    </div>
    <div class="text-xs font-mono text-zinc-400">
      <span class="text-zinc-600">// VERIFIED TRACK RECORD</span> UFLS DANANG · UDECAREER · IELTS 7.5
    </div>
  </div>

  <!-- Interactive Timeline Table -->
  <div class="space-y-4">
    {timeline.map((item, index) => (
      <div 
        class="exp-row group p-6 sm:p-8 rounded-2xl bg-dark-900 border border-white/5 hover:border-brand-500/40 transition-all duration-400 hover:bg-dark-850 hover:shadow-[0_0_30px_rgba(56,116,255,0.06)]"
      >
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
          <!-- Left: Index + Role & Organization -->
          <div class="flex items-start sm:items-center gap-4 sm:gap-6">
            <span class="font-mono text-xs text-brand-neon/60 group-hover:text-brand-neon font-bold tracking-widest pt-1 sm:pt-0">
              0{index + 1}
            </span>
            <div>
              <div class="flex items-center gap-3 flex-wrap">
                <h3 class="text-xl sm:text-2xl font-bold text-white group-hover:text-brand-neon transition-colors">
                  {item.role}
                </h3>
                {item.badge && (
                  <span class="px-2.5 py-0.5 rounded-full bg-brand-neon/10 border border-brand-neon/30 text-brand-neon text-[10px] font-mono font-semibold">
                    {item.badge}
                  </span>
                )}
              </div>
              <p class="text-sm font-mono text-zinc-400 mt-1">
                {item.organization} <span class="text-zinc-600">•</span> <span class="text-zinc-500 text-xs">{item.type}</span>
              </p>
            </div>
          </div>

          <!-- Right: Year & Arrow -->
          <div class="flex items-center justify-between sm:justify-end gap-6 pt-2 lg:pt-0 border-t border-zinc-800/50 lg:border-none">
            <span class="font-mono text-xs sm:text-sm tracking-wider font-semibold text-zinc-400 group-hover:text-white transition-colors">
              {item.year}
            </span>
            <div class="w-8 h-8 rounded-full border border-zinc-800 group-hover:border-brand-neon group-hover:bg-brand-neon group-hover:text-dark-950 text-zinc-500 flex items-center justify-center transition-all duration-300">
              <svg class="w-4 h-4 transform -rotate-45 group-hover:rotate-0 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </div>
          </div>
        </div>

        <!-- Description -->
        <p class="text-sm text-zinc-400 mt-4 pt-4 border-t border-white/5 leading-relaxed max-w-3xl">
          {item.description}
        </p>
      </div>
    ))}
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener('DOMContentLoaded', () => {
    gsap.from('.experience-header', {
      scrollTrigger: {
        trigger: '.experience-header',
        start: 'top 85%',
        toggleActions: 'play none none none',
      },
      y: 40,
      opacity: 0,
      duration: 0.8,
      ease: 'power3.out',
    });

    ScrollTrigger.batch('.exp-row', {
      start: 'top 85%',
      onEnter: (batch) => {
        gsap.from(batch, {
          y: 40,
          opacity: 0,
          stagger: 0.12,
          duration: 0.8,
          ease: 'power3.out',
          overwrite: true,
        });
      },
      once: true,
    });
  });
</script>
