---
interface ExperienceItem {
  role: string;
  organization: string;
  year: string;
  type: string;
  description: string;
  highlight?: boolean;
}

const timeline: ExperienceItem[] = [
  {
    role: 'Business Analysis & Analytics Intern',
    organization: 'FinTech Growth Lab',
    year: '2025 → PRESENT',
    type: 'INTERNSHIP',
    description: 'Collaborating directly with product managers and engineers to elicit requirements for user onboarding; designed low-fi dashboard wireframes in Mokkup.ai and authored 25+ Jira user stories with acceptance criteria.',
    highlight: true,
  },
  {
    role: 'Student Business Analyst (Capstone Project)',
    organization: 'Enterprise Analytics Clinic',
    year: '2024 — 2025',
    type: 'CONSULTING CLIENT',
    description: 'Advised an omnichannel retailer on inventory turnover bottlenecks; queried 150K+ transactional records via PostgreSQL and built interactive Power BI dashboards that identified $180K in slow-moving stock.',
  },
  {
    role: 'Data Analysis & Research Assistant',
    organization: 'Department of Information Systems',
    year: '2023 — 2024',
    type: 'ACADEMIC RESEARCH',
    description: 'Conducted exploratory data analysis (EDA) using Python (Pandas) and Excel; cleaned and validated multi-year survey datasets, producing statistical distribution charts for faculty publications.',
  },
  {
    role: 'VP of Operations & Project Management',
    organization: 'University Business & Analytics Club',
    year: '2022 — 2023',
    type: 'LEADERSHIP',
    description: 'Mapped end-to-end event planning workflows using BPMN diagrams; introduced Jira for committee task management, cutting event coordination cycle time by 35%.',
  },
  {
    role: 'B.S. in Information Systems & Business Analytics',
    organization: 'School of Computing & Business',
    year: '2022 — 2026 (EXPECTED)',
    type: 'EDUCATION (3.85 GPA)',
    description: 'Key Coursework: Relational Database Systems (SQL), Business Process Engineering (BPMN), Agile Software Delivery, Enterprise Systems (ERP), Business Statistics.',
  },
];
---

<section id="experience" class="py-24 sm:py-32 px-6 lg:px-12 max-w-7xl mx-auto">
  <!-- Section Title Header -->
  <div class="experience-header border-b border-white/10 pb-8 mb-16 flex flex-col md:flex-row md:items-end justify-between gap-6">
    <div class="space-y-3">
      <div class="flex items-center gap-2 text-xs font-mono tracking-widest text-brand-neon uppercase">
        <span class="w-1.5 h-1.5 rounded-full bg-brand-neon"></span>
        <span>&#123; 04 / EXPERIENCE &amp; EDUCATION &#125;</span>
      </div>
      <h2 class="text-4xl sm:text-6xl font-bold tracking-tight text-white uppercase">
        BACKGROUND &amp; TIMELINE
      </h2>
    </div>
    <div class="text-xs font-mono text-zinc-400">
      <span class="text-zinc-600">// TRACK RECORD</span> ACADEMIC EXCELLENCE &amp; PRACTICAL APPLICATION
    </div>
  </div>

  <!-- Interactive Timeline Table -->
  <div class="space-y-4">
    {timeline.map((item, index) => (
      <div 
        class="exp-row group p-6 sm:p-8 rounded-2xl bg-dark-900 border border-white/5 hover:border-brand-500/40 transition-all duration-400 hover:bg-dark-850 hover:shadow-[0_0_30px_rgba(0,255,135,0.06)]"
      >
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
          <!-- Left: Index + Role & Organization -->
          <div class="flex items-start sm:items-center gap-4 sm:gap-6">
            <span class="font-mono text-xs text-brand-neon/60 group-hover:text-brand-neon font-bold tracking-widest pt-1 sm:pt-0">
              0{index + 1}
            </span>
            <div>
              <div class="flex items-center gap-3 flex-wrap">
                <h3 class="text-xl sm:text-2xl font-bold text-white group-hover:text-brand-neon transition-colors">
                  {item.role}
                </h3>
                {item.highlight && (
                  <span class="px-2 py-0.5 rounded-full bg-brand-neon/10 border border-brand-neon/30 text-brand-neon text-[10px] font-mono font-semibold">
                    CURRENT
                  </span>
                )}
              </div>
              <p class="text-sm font-mono text-zinc-400 mt-1">
                {item.organization} <span class="text-zinc-600">•</span> <span class="text-zinc-500 text-xs">{item.type}</span>
              </p>
            </div>
          </div>

          <!-- Right: Year & Arrow -->
          <div class="flex items-center justify-between sm:justify-end gap-6 pt-2 lg:pt-0 border-t border-zinc-800/50 lg:border-none">
            <span class="font-mono text-xs sm:text-sm tracking-wider font-semibold text-zinc-400 group-hover:text-white transition-colors">
              {item.year}
            </span>
            <div class="w-8 h-8 rounded-full border border-zinc-800 group-hover:border-brand-neon group-hover:bg-brand-neon group-hover:text-dark-950 text-zinc-500 flex items-center justify-center transition-all duration-300">
              <svg class="w-4 h-4 transform -rotate-45 group-hover:rotate-0 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </div>
          </div>
        </div>

        <!-- Description -->
        <p class="text-sm text-zinc-400 mt-4 pt-4 border-t border-white/5 leading-relaxed max-w-3xl">
          {item.description}
        </p>
      </div>
    ))}
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener('DOMContentLoaded', () => {
    gsap.from('.experience-header', {
      scrollTrigger: {
        trigger: '.experience-header',
        start: 'top 85%',
        toggleActions: 'play none none none',
      },
      y: 40,
      opacity: 0,
      duration: 0.8,
      ease: 'power3.out',
    });

    ScrollTrigger.batch('.exp-row', {
      start: 'top 85%',
      onEnter: (batch) => {
        gsap.from(batch, {
          y: 40,
          opacity: 0,
          stagger: 0.12,
          duration: 0.8,
          ease: 'power3.out',
          overwrite: true,
        });
      },
      once: true,
    });
  });
</script>
