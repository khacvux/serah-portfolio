---
interface ExperienceItem {
  role: string;
  organization: string;
  year: string;
  type: string;
  description: string;
  badge?: string;
  highlight?: boolean;
}

const timeline: ExperienceItem[] = [
  {
    role: 'Business Analysis (ITBA) Thực Chiến: Cơ bản + Kỹ năng ITBA',
    organization: 'UDECAREER',
    year: '2026',
    type: 'PROFESSIONAL CERTIFICATION',
    badge: 'ITBA CERTIFIED',
    description: 'Comprehensive practical training in IT Business Analysis: requirement elicitation, writing User Stories with Acceptance Criteria, drafting BRD & FRD specifications, process mapping (BPMN), backlog grooming, and Agile/Scrum ceremonies.',
    highlight: true,
  },
  {
    role: 'English Proficiency: IELTS 7.5',
    organization: 'International English Language Testing System',
    year: 'July 2026',
    type: 'LANGUAGE CERTIFICATION',
    badge: 'C1 ADVANCED',
    description: 'Fluent professional English proficiency for cross-border collaboration, client requirement discovery calls, executive presentations, and technical documentation.',
    highlight: true,
  },
  {
    role: 'Bachelor of Arts (BA) — Oriental Studies',
    organization: 'The University of Danang - University of Foreign Language Studies',
    year: 'Aug 2019 — Aug 2023',
    type: 'DEGREE (FINAL GPA: 3.7 / 4.0)',
    badge: 'GPA 3.7 / 4.0',
    description: 'Major in Oriental Studies. Developed advanced research methodologies, structured analytical thinking, cross-cultural communication, and qualitative data synthesis. Graduated with high academic distinction.',
  },
  {
    role: 'Business Analysis Case Study Capstone',
    organization: 'Enterprise E-Commerce Simulation',
    year: '2024 — 2025',
    type: 'PRACTICAL PROJECT',
    description: 'Conducted end-to-end business analysis for a retail platform; wireframed dashboard prototypes in Mokkup.ai, structured SQL aggregations, and authored comprehensive requirements documentation (BRD).',
  },
  {
    role: 'Project Coordination & Research Assistant',
    organization: 'University Academic Initiatives',
    year: '2021 — 2023',
    type: 'LEADERSHIP & ACADEMIC',
    description: 'Managed schedules, stakeholder correspondence, and research documentation for academic symposiums; synthesized multi-source data into executive presentation summaries.',
  },
];
---

<section id="experience" class="py-24 sm:py-32 px-6 lg:px-12 max-w-[1440px] mx-auto">
  <!-- Section Title Header in Sky Blue tone -->
  <div class="experience-header border-b border-[#d5e7f5] pb-8 mb-16 flex flex-col md:flex-row md:items-end justify-between gap-6">
    <div class="space-y-3">
      <div class="flex items-center gap-2 text-xs font-mono tracking-widest text-[#5a7894] font-bold uppercase">
        <span class="w-1.5 h-1.5 rounded-full bg-[#0ea5e9]"></span>
        <span>&#123; 03 &#125; EXPERIENCE &amp; CREDENTIALS</span>
      </div>
      <h2 class="text-4xl sm:text-6xl md:text-7xl font-semibold tracking-tight text-[#091e36] uppercase">
        TRACK RECORD
      </h2>
    </div>
    <div class="text-xs font-mono text-[#5a7894]">
      <span class="text-[#0284c7] font-bold">// VERIFIED:</span> UFLS DANANG · UDECAREER · IELTS 7.5
    </div>
  </div>

  <!-- Table Header Bar in Sky Blue tone -->
  <div class="hidden md:grid grid-cols-12 gap-6 pb-4 border-b border-[#d5e7f5] font-mono text-xs text-[#5a7894] uppercase tracking-wider font-semibold">
    <div class="col-span-1">#</div>
    <div class="col-span-5">ROLE / CERTIFICATION</div>
    <div class="col-span-4">ORGANIZATION / INSTITUTION</div>
    <div class="col-span-2 text-right">YEAR</div>
  </div>

  <!-- Interactive Timeline Rows with Hairline Dividers -->
  <div class="divide-y divide-[#d5e7f5] border-b border-[#d5e7f5]">
    {timeline.map((item, index) => (
      <div 
        class="exp-row group py-8 transition-colors duration-300 hover:bg-sky-500/[0.04]"
        data-cursor="interactive"
      >
        <div class="grid grid-cols-1 md:grid-cols-12 gap-4 md:gap-6 items-start md:items-center">
          <!-- Index -->
          <div class="col-span-1 font-mono text-xs text-[#5a7894] group-hover:text-[#0284c7] font-bold tracking-widest transition-colors">
            {`0${index + 1}`}
          </div>

          <!-- Role -->
          <div class="col-span-5 space-y-1">
            <div class="flex items-center gap-3 flex-wrap">
              <h3 class="text-xl sm:text-2xl font-bold text-[#091e36] group-hover:text-[#0284c7] transition-colors">
                {item.role}
              </h3>
              {item.badge && (
                <span class="px-2.5 py-0.5 border border-[#d5e7f5] bg-[#eef6fc] text-[#0284c7] text-[10px] font-mono font-semibold">
                  {item.badge}
                </span>
              )}
            </div>
          </div>

          <!-- Organization -->
          <div class="col-span-4 font-mono text-xs sm:text-sm text-[#1e3852]">
            <span>{item.organization}</span>
            <span class="text-[#5a7894] block text-[11px] mt-0.5">{item.type}</span>
          </div>

          <!-- Year & Arrow -->
          <div class="col-span-2 flex items-center justify-between md:justify-end gap-4 font-mono text-xs sm:text-sm text-[#091e36]">
            <span class="font-semibold tracking-wider">{item.year}</span>
            <div class="w-7 h-7 rounded-full border border-[#d5e7f5] group-hover:border-[#0284c7] group-hover:bg-[#0284c7] group-hover:text-white text-[#091e36] flex items-center justify-center transition-all">
              <svg class="w-3.5 h-3.5 transform group-hover:translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </div>
          </div>
        </div>

        <!-- Description Details -->
        <p class="text-xs sm:text-sm text-[#2c4c6e] mt-3 md:pl-[8.333%] leading-relaxed max-w-4xl">
          {item.description}
        </p>
      </div>
    ))}
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener('DOMContentLoaded', () => {
    gsap.from('.experience-header', {
      scrollTrigger: {
        trigger: '.experience-header',
        start: 'top 85%',
        toggleActions: 'play none none none',
        once: true,
      },
      y: 35,
      autoAlpha: 0,
      duration: 0.8,
      ease: 'power3.out',
      clearProps: 'all',
    });

    ScrollTrigger.batch('.exp-row', {
      start: 'top 85%',
      onEnter: (batch) => {
        gsap.from(batch, {
          y: 35,
          autoAlpha: 0,
          stagger: 0.1,
          duration: 0.8,
          ease: 'power3.out',
          clearProps: 'all',
          overwrite: 'auto',
        });
      },
      once: true,
    });
  });
</script>
