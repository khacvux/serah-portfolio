---
interface BAProject {
  number: string;
  title: string;
  domain: string;
  tools: string[];
  year: string;
  problem: string;
  solution: string;
  impact: string;
  image: string;
}

const projects: BAProject[] = [
  {
    number: '01',
    title: 'Sales Performance & Revenue Intelligence Dashboard',
    domain: 'RETAIL & E-COMMERCE',
    tools: ['POWER BI', 'SQL', 'MOKKUP.AI', 'KPI DEFINITION'],
    year: '2025',
    problem: 'Regional sales teams lacked unified visibility into product line profitability and discount variance across 12 territories.',
    solution: 'Engineered KPI wireframes in Mokkup.ai, structured complex SQL aggregations, and deployed an interactive Power BI dashboard tracking revenue velocity.',
    impact: 'Identified 3 underperforming categories, optimizing discount strategies to recover $180K in annual margin leakage.',
    image: '/assets/projects/verizon.jpg',
  },
  {
    number: '02',
    title: 'Customer Satisfaction & Retention Analysis (CSAT / NPS)',
    domain: 'SAAS & DIGITAL SERVICES',
    tools: ['TABLEAU', 'PYTHON', 'EXCEL', 'CHURN PREDICTION'],
    year: '2024',
    problem: 'SaaS platform experienced a 24% customer churn within the first 60 days of onboarding with vague exit survey data.',
    solution: 'Conducted cohort churn modeling, mapped customer touchpoints, and built diagnostic dashboards correlating feature adoption with Net Promoter Score.',
    impact: 'Discovered critical friction in billing setup; redesigned onboarding flow reduced early churn by 18%.',
    image: '/assets/projects/wagamama.jpg',
  },
  {
    number: '03',
    title: 'Operational Workflow Optimization & Process Automation',
    domain: 'SUPPLY CHAIN & LOGISTICS',
    tools: ['BPMN 2.0', 'JIRA', 'AS-IS / TO-BE', 'ROOT CAUSE'],
    year: '2024',
    problem: 'Order fulfillment suffered from manual approval bottlenecks and disconnected ERP spreadsheets, delaying shipments by 4.2 days.',
    solution: 'Mapped comprehensive AS-IS vs. TO-BE workflows using BPMN 2.0 standards, authored Agile user stories in Jira, and facilitated cross-team sprint planning.',
    impact: 'Automated 4 manual handover checkpoints, cutting average order cycle time from 4.2 days to under 24 hours.',
    image: '/assets/projects/bt.jpg',
  },
  {
    number: '04',
    title: 'Product Launch Feasibility & Requirements Document (BRD)',
    domain: 'FINTECH & BANKING',
    tools: ['BRD / FRD', 'CONFLUENCE', 'FIGMA', 'STAKEHOLDER MGMT'],
    year: '2024',
    problem: 'Commercial bank required a compliant mobile micro-lending feature with strict KYC validation and credit bureau integrations.',
    solution: 'Gathered requirements across legal, engineering, and compliance units; delivered a 35-page BRD with detailed user stories, wireframes, and acceptance criteria.',
    impact: 'Achieved 100% stakeholder sign-off on first review cycle; zero scope creep during 4-month MVP development sprint.',
    image: '/assets/projects/pnc.jpg',
  },
  {
    number: '05',
    title: 'Supply Chain Inventory & Safety Stock Analysis',
    domain: 'MANUFACTURING',
    tools: ['SQL', 'ADVANCED EXCEL', 'POWER BI', 'FORECASTING'],
    year: '2023',
    problem: 'Excess component inventory was tying up $650K in working capital while critical parts frequently encountered stockouts.',
    solution: 'Executed SQL queries against ERP inventory history, calculated reorder points and safety stock levels based on supplier lead-time variance.',
    impact: 'Reduced surplus warehouse stock holding by 21% while raising on-time order fulfillment to 99.4%.',
    image: '/assets/projects/trm.jpg',
  },
  {
    number: '06',
    title: 'Enterprise Data Analytics Platform Usability Audit',
    domain: 'B2B ENTERPRISE',
    tools: ['USER INTERVIEWS', 'MOKKUP.AI', 'KPI MAPPING', 'AGILE'],
    year: '2023',
    problem: 'Corporate reporting team was overwhelmed by ad-hoc data requests due to clunky, unintuitive legacy analytics portals.',
    solution: 'Interviewed 18 department heads, synthesized recurring data queries, and created low-fidelity dashboard wireframes prioritizing self-service analytics.',
    impact: 'Decreased routine ticket volume for BI analysts by 45% through standardized executive report views.',
    image: '/assets/projects/nielsen.jpg',
  },
];
---

<section id="projects" class="py-24 sm:py-32 px-6 lg:px-12 max-w-7xl mx-auto">
  <!-- Section Title Header -->
  <div class="project-header border-b border-slate-200 pb-8 mb-16 flex flex-col md:flex-row md:items-end justify-between gap-6">
    <div class="space-y-3">
      <div class="flex items-center gap-2 text-xs font-mono tracking-widest text-sky-600 font-bold uppercase">
        <span class="w-1.5 h-1.5 rounded-full bg-sky-500"></span>
        <span>&#123; 01 / CASE STUDIES &amp; PROJECTS &#125;</span>
      </div>
      <h2 class="text-4xl sm:text-6xl font-bold tracking-tight text-ink-950 uppercase">
        FEATURED BA WORK
      </h2>
    </div>
    <div class="text-xs font-mono text-ink-500">
      <span class="text-ink-400">// METHODOLOGY</span> PROBLEM → ANALYSIS → OUTCOME
    </div>
  </div>

  <!-- Projects Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-10 lg:gap-14">
    {projects.map((project) => (
      <article 
        class="project-card group flex flex-col space-y-5 bg-white border border-slate-200/90 hover:border-sky-400 rounded-2xl p-5 sm:p-7 transition-colors duration-300 shadow-sm hover:shadow-[0_12px_32px_rgba(2,132,199,0.12)] cursor-pointer"
        data-cursor="project"
      >
        <!-- Preview Container with Parallax Zoom -->
        <div class="relative w-full aspect-[16/10] sm:aspect-[16/11] rounded-xl overflow-hidden bg-slate-900">
          <img 
            src={project.image} 
            alt={project.title} 
            class="project-img w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out brightness-90 group-hover:brightness-100"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-transparent to-transparent"></div>
          
          <!-- Top floating card meta -->
          <div class="absolute top-4 left-4 right-4 flex items-center justify-between text-xs font-mono pointer-events-none">
            <span class="px-2.5 py-1 rounded-md bg-slate-900/80 backdrop-blur-md border border-white/20 text-sky-400 font-bold shadow-sm">
              {project.number}
            </span>
            <span class="px-2.5 py-1 rounded-md bg-slate-900/80 backdrop-blur-md border border-white/20 text-slate-200 shadow-sm">
              {project.domain}
            </span>
          </div>

          <!-- Bottom floating impact metric badge -->
          <div class="absolute bottom-4 left-4 right-4 p-3 rounded-lg bg-slate-950/90 backdrop-blur-md border border-sky-400/40 shadow-md">
            <div class="text-[10px] font-mono text-sky-400 font-bold uppercase tracking-wider">
              KEY BUSINESS IMPACT
            </div>
            <div class="text-xs text-white font-medium line-clamp-1 mt-0.5">
              {project.impact}
            </div>
          </div>
        </div>

        <!-- Project Details -->
        <div class="flex flex-col space-y-3 pt-2">
          <!-- Tools used pills -->
          <div class="flex items-center gap-1.5 flex-wrap text-[10px] font-mono tracking-wider">
            {project.tools.map((tool) => (
              <span class="px-2.5 py-0.5 rounded-full bg-sky-50 border border-sky-200/80 text-sky-700 font-semibold">
                {tool}
              </span>
            ))}
          </div>

          <!-- Title and arrow -->
          <div class="flex items-baseline justify-between gap-4">
            <h3 class="text-xl sm:text-2xl font-bold tracking-tight text-ink-950 group-hover:text-sky-600 transition-colors">
              {project.title}
            </h3>
            <div class="w-8 h-8 rounded-full border border-slate-200 group-hover:border-sky-500 group-hover:bg-sky-500 group-hover:text-white text-ink-400 flex items-center justify-center transition-all shrink-0">
              <svg class="w-4 h-4 transform -rotate-45 group-hover:rotate-0 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
              </svg>
            </div>
          </div>

          <!-- Problem & Solution breakdown -->
          <div class="text-xs space-y-1.5 pt-1 text-ink-600 leading-relaxed">
            <p><strong class="text-ink-950 font-mono text-[11px]">PROBLEM:</strong> {project.problem}</p>
            <p><strong class="text-sky-700 font-mono text-[11px]">APPROACH:</strong> {project.solution}</p>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  window.addEventListener('DOMContentLoaded', () => {
    gsap.from('.project-header', {
      scrollTrigger: {
        trigger: '.project-header',
        start: 'top 85%',
        toggleActions: 'play none none none',
      },
      y: 40,
      opacity: 0,
      duration: 0.8,
      ease: 'power3.out',
    });

    ScrollTrigger.batch('.project-card', {
      start: 'top 85%',
      onEnter: (batch) => {
        gsap.from(batch, {
          y: 50,
          autoAlpha: 0,
          stagger: 0.15,
          duration: 0.85,
          ease: 'power3.out',
          clearProps: 'transform,opacity,visibility',
          overwrite: 'auto',
        });
      },
      once: true,
    });
  });
</script>
